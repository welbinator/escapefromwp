---
import Sidebar from "../components/Sidebar.astro";
export interface Props { title?: string; description?: string; }
const {
  title = "Escape From WP — Break out of WordPress",
  description = "A tactical migration service that gets your site off WordPress and onto a faster, more secure, modern stack. Plan your escape.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isStaging = base !== "";
const ogImage = new URL(`${base}/images/og-card.png`, Astro.site).href;
// Canonical always points at the production domain so it's correct even if a
// staging/preview copy is ever crawled.
const PROD = "https://escapefromwp.com";
const path = Astro.url.pathname.replace(base, "") || "/";
const canonical = new URL(path, PROD).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Escape From WP",
  description:
    "A tactical WordPress migration service that moves your site off WordPress onto a faster, more secure, modern static/headless stack.",
  url: PROD,
  image: `${PROD}/images/og-card.png`,
  logo: `${PROD}/favicon.svg`,
  areaServed: "US",
  serviceType: "WordPress migration and website rebuild",
  slogan: "Break out of WordPress.",
  sameAs: ["https://twitter.com/EscapeFromWP"],
  offers: {
    "@type": "Offer",
    description: "Free WordPress migration assessment with a fixed quote before any work starts.",
    price: "0",
    priceCurrency: "USD",
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function(){
        var w = (window.innerWidth > 768 && localStorage.getItem('sb-collapsed') === '1') ? '75px' : '260px';
        document.documentElement.style.setProperty('--sidebar-w', w);
      })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NB17G50LNN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NB17G50LNN');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Escape From WordPress — tactical migration service" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Escape From WordPress — tactical migration service" />
    <meta name="theme-color" content="#0b0405" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href={`${base}/images/hero-1600.webp`} />
    {!isStaging && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(orgSchema)}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <!-- Mobile top bar -->
    <div class="mobile-topbar">
      <button id="sbHamburger" class="sb-hamburger" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
      <a href={`${base}/`} class="mobile-wordmark"><span class="mw-bracket">[</span><s>WP</s><span class="mw-bracket">]</span></a>
      <a href={`${base}/#breakout`} class="mobile-cta btn btn-primary">Start</a>
    </div>
    <div class="app-shell">
      <Sidebar />
      <main class="main-content">
        <slot />
      </main>
    </div>
    <script is:inline>
      document.documentElement.classList.add("js");
      const risers = [...document.querySelectorAll(".rise")];
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }),
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
      );
      risers.forEach((el) => io.observe(el));
      setTimeout(() => risers.forEach((el) => el.classList.add("in")), 2500);
    </script>
  </body>
</html>
<style is:global>@import "../styles/global.css";

/* App shell */
.app-shell { display: flex; min-height: 100vh; }
.main-content { margin-left: 260px; flex: 1; min-width: 0; }

/* Mobile top bar */
.mobile-topbar {
  display: none;
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 52px;
  background: var(--graphite);
  border-bottom: 1px solid var(--steel);
  align-items: center;
  padding: 0 16px;
  gap: 12px;
  z-index: 198;
}
.sb-hamburger {
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 4px;
}
.sb-hamburger span {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--chalk);
}
.mobile-wordmark {
  font-family: var(--font-mono);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--chalk);
  text-decoration: none;
  letter-spacing: 0.06em;
  flex: 1;
}
.mobile-wordmark s { text-decoration-color: var(--signal-red); }
.mw-bracket { color: var(--signal-red); }
.mobile-cta { font-size: 0.75rem; padding: 6px 12px; }

@media (max-width: 768px) {
  .mobile-topbar { display: flex; }
  .main-content { margin-left: 0; padding-top: 52px; }
}
</style>
