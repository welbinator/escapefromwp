---
import { execSync } from "child_process";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = Astro.url.pathname;
const commitHash = execSync("git rev-parse --short HEAD").toString().trim();

// Determine active page
const is = (path: string) => url === base + path || url === base + path + "/";
const startsWith = (path: string) => url.startsWith(base + path);
---

<aside class="sidebar" id="sidebar">
  <!-- Logo -->
  <div class="sb-logo">
    <a href={`${base}/`} class="sb-wordmark">
      <span class="sb-bracket">[</span>ESCAPE<span class="sb-bracket">]</span>
    </a>
    <button class="sb-close" id="sbClose" aria-label="Close menu">✕</button>
  </div>

  <nav class="sb-nav">
    <!-- Main -->
    <div class="sb-section-label">Overview</div>
    <a href={`${base}/`} class:list={["sb-link", { active: is("/") }]}>
      Home
    </a>

    <!-- Explore -->
    <div class="sb-section-label">Explore</div>
    <a href={`${base}/`}#prison class:list={["sb-link", { active: false }]}>
      Why leave WordPress
    </a>
    <a href={`${base}/`}#plan class:list={["sb-link", { active: false }]}>
      How it works
    </a>
    <a href={`${base}/`}#tiers class:list={["sb-link", { active: false }]}>
      Pricing
    </a>

    <!-- Resources -->
    <div class="sb-section-label">Resources</div>
    <a href={`${base}/evidence`} class:list={["sb-link", { active: startsWith("/evidence") }]}>
      Evidence
    </a>
    <a href={`${base}/stories`} class:list={["sb-link", { active: startsWith("/stories") }]}>
      Stories
    </a>
    <a href={`${base}/escapees`} class:list={["sb-link", { active: startsWith("/escapees") }]}>
      Who we've helped
    </a>

    <!-- Tools -->
    <div class="sb-section-label">Tools</div>
    <a href={`${base}/liberate`} class:list={["sb-link", { active: startsWith("/liberate") }]}>
      Free preview
    </a>
  </nav>

  <!-- Footer: version + collapse -->
  <div class="sb-footer">
    <a href={`${base}/#breakout`} class="btn btn-primary sb-cta">Get started free</a>
    <div class="sb-meta">
      <button class="sb-collapse-btn" id="sbCollapseBtn" aria-label="Toggle sidebar">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><path d="M10 3L5 8l5 5"/></svg>
      </button>
      <span class="sb-version">EscapeFromWP ({commitHash})</span>
    </div>
  </div>
</aside>

<!-- Overlay for mobile -->
<div class="sb-overlay" id="sbOverlay"></div>

<style>
  .sidebar {
    position: fixed;
    top: 0; left: 0;
    width: 260px;
    height: 100vh;
    background: var(--graphite);
    border-right: 1px solid var(--steel);
    display: flex;
    flex-direction: column;
    z-index: 200;
    overflow-y: auto;
    transition: transform 0.25s ease;
  }

  .sb-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 16px;
    border-bottom: 1px solid var(--steel);
    flex-shrink: 0;
  }

  .sb-wordmark {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--chalk);
    letter-spacing: 0.06em;
    text-decoration: none;
    flex: 1;
  }
  .sb-wordmark:hover { color: var(--term-green); }
  .sb-bracket { color: var(--signal-red); }

  .sb-collapse-btn {
    background: none;
    border: 1px solid var(--steel);
    border-radius: 4px;
    color: var(--slate-dim);
    cursor: pointer;
    padding: 4px 6px;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: color 0.15s, border-color 0.15s;
  }
  .sb-collapse-btn:hover { color: var(--chalk); border-color: var(--slate); }

  .sb-close {
    display: none;
    background: none;
    border: none;
    color: var(--slate);
    cursor: pointer;
    font-size: 1rem;
    padding: 4px;
    line-height: 1;
  }
  .sb-close:hover { color: var(--chalk); }

  .sb-nav {
    flex: 1;
    padding: 12px 0;
    overflow-y: auto;
  }

  .sb-section-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-dim);
    padding: 14px 20px 4px;
  }

  .sb-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--slate);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
    border-radius: 0;
  }
  .sb-link:hover {
    color: var(--chalk);
    background: rgba(255,255,255,0.04);
  }
  .sb-link.active {
    color: var(--term-green);
    background: rgba(78, 227, 107, 0.07);
  }
  .sb-link.active .sb-icon { color: var(--term-green); }

  .sb-icon {
    font-size: 0.85rem;
    width: 18px;
    text-align: center;
    color: var(--slate-dim);
    flex-shrink: 0;
    opacity: 0.5;
  }

  .sb-footer {
    padding: 16px 20px 24px;
    border-top: 1px solid var(--steel);
    flex-shrink: 0;
  }

  .sb-cta {
    display: block;
    text-align: center;
    width: 100%;
    padding: 10px 0;
    font-size: 0.85rem;
  }

  .sb-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    justify-content: space-between;
  }

  .sb-version {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--slate-dim);
    letter-spacing: 0.04em;
  }

  /* Collapsed state */
  .sidebar.collapsed { width: 48px; }
  .sidebar.collapsed .sb-nav,
  .sidebar.collapsed .sb-cta,
  .sidebar.collapsed .sb-version,
  .sidebar.collapsed .sb-wordmark,
  .sidebar.collapsed .sb-close { display: none; }
  .sidebar.collapsed .sb-logo { justify-content: center; }
  .sidebar.collapsed .sb-footer { padding: 12px 8px; }
  .sidebar.collapsed .sb-meta { justify-content: center; }
  .sidebar.collapsed .sb-collapse-btn svg { transform: rotate(180deg); }

  .sb-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 199;
  }

  /* Mobile hamburger trigger is added by each page's header bar */
  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
    }
    .sidebar.open {
      transform: translateX(0);
    }
    .sb-close { display: block; }
    .sb-overlay.open { display: block; }
  }
</style>

<script is:inline>
  const sidebar = document.getElementById("sidebar");
  const overlay = document.getElementById("sbOverlay");
  const sbClose = document.getElementById("sbClose");
  const hamburger = document.getElementById("sbHamburger");
  const collapseBtn = document.getElementById("sbCollapseBtn");
  const mainContent = document.querySelector(".main-content");

  function openSidebar() {
    sidebar && sidebar.classList.add("open");
    overlay && overlay.classList.add("open");
    document.body.style.overflow = "hidden";
  }
  function closeSidebar() {
    sidebar && sidebar.classList.remove("open");
    overlay && overlay.classList.remove("open");
    document.body.style.overflow = "";
  }

  function applyCollapse(collapsed) {
    if (collapsed) {
      sidebar && sidebar.classList.add("collapsed");
      if (mainContent) mainContent.style.marginLeft = "48px";
    } else {
      sidebar && sidebar.classList.remove("collapsed");
      if (mainContent) mainContent.style.marginLeft = "260px";
    }
  }

  // Restore from localStorage
  if (localStorage.getItem("sb-collapsed") === "1") applyCollapse(true);

  collapseBtn && collapseBtn.addEventListener("click", () => {
    const isCollapsed = sidebar && sidebar.classList.contains("collapsed");
    applyCollapse(!isCollapsed);
    localStorage.setItem("sb-collapsed", isCollapsed ? "0" : "1");
  });

  hamburger && hamburger.addEventListener("click", openSidebar);
  sbClose && sbClose.addEventListener("click", closeSidebar);
  overlay && overlay.addEventListener("click", closeSidebar);
</script>
