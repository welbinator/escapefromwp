---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = Astro.url.pathname;

// Determine active page
const is = (path: string) => url === base + path || url === base + path + "/";
const startsWith = (path: string) => url.startsWith(base + path);
---

<aside class="sidebar" id="sidebar">
  <!-- Logo -->
  <div class="sb-logo">
    <a href={`${base}/`} class="sb-wordmark">
      <span class="sb-bracket">[</span>ESCAPE<span class="sb-bracket">]</span>
    </a>
    <button class="sb-close" id="sbClose" aria-label="Close menu">✕</button>
  </div>

  <nav class="sb-nav">
    <!-- Main -->
    <div class="sb-section-label">Overview</div>
    <a href={`${base}/`} class:list={["sb-link", { active: is("/") }]}>
      <span class="sb-icon">⌂</span> Home
    </a>

    <!-- Explore -->
    <div class="sb-section-label">Explore</div>
    <a href={`${base}/`}#prison class:list={["sb-link", { active: false }]}>
      <span class="sb-icon">⚠</span> Why leave WordPress
    </a>
    <a href={`${base}/`}#plan class:list={["sb-link", { active: false }]}>
      <span class="sb-icon">→</span> How it works
    </a>
    <a href={`${base}/`}#tiers class:list={["sb-link", { active: false }]}>
      <span class="sb-icon">$</span> Pricing
    </a>

    <!-- Resources -->
    <div class="sb-section-label">Resources</div>
    <a href={`${base}/evidence`} class:list={["sb-link", { active: startsWith("/evidence") }]}>
      <span class="sb-icon">📋</span> Evidence
    </a>
    <a href={`${base}/stories`} class:list={["sb-link", { active: startsWith("/stories") }]}>
      <span class="sb-icon">💬</span> Stories
    </a>
    <a href={`${base}/escapees`} class:list={["sb-link", { active: startsWith("/escapees") }]}>
      <span class="sb-icon">✓</span> Who we've helped
    </a>

    <!-- Tools -->
    <div class="sb-section-label">Tools</div>
    <a href={`${base}/liberate`} class:list={["sb-link", { active: startsWith("/liberate") }]}>
      <span class="sb-icon">⚡</span> Free preview
    </a>
  </nav>

  <!-- CTA -->
  <div class="sb-footer">
    <a href={`${base}/#breakout`} class="btn btn-primary sb-cta">Get started free</a>
    <div class="sb-byline">escape<span>from</span>wp.com</div>
  </div>
</aside>

<!-- Overlay for mobile -->
<div class="sb-overlay" id="sbOverlay"></div>

<style>
  .sidebar {
    position: fixed;
    top: 0; left: 0;
    width: 260px;
    height: 100vh;
    background: var(--graphite);
    border-right: 1px solid var(--steel);
    display: flex;
    flex-direction: column;
    z-index: 200;
    overflow-y: auto;
    transition: transform 0.25s ease;
  }

  .sb-logo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--steel);
    flex-shrink: 0;
  }

  .sb-wordmark {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--chalk);
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .sb-wordmark:hover { color: var(--term-green); }
  .sb-bracket { color: var(--signal-red); }

  .sb-close {
    display: none;
    background: none;
    border: none;
    color: var(--slate);
    cursor: pointer;
    font-size: 1rem;
    padding: 4px;
    line-height: 1;
  }
  .sb-close:hover { color: var(--chalk); }

  .sb-nav {
    flex: 1;
    padding: 12px 0;
    overflow-y: auto;
  }

  .sb-section-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-dim);
    padding: 14px 20px 4px;
  }

  .sb-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--slate);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
    border-radius: 0;
  }
  .sb-link:hover {
    color: var(--chalk);
    background: rgba(255,255,255,0.04);
  }
  .sb-link.active {
    color: var(--term-green);
    background: rgba(78, 227, 107, 0.07);
  }
  .sb-link.active .sb-icon { color: var(--term-green); }

  .sb-icon {
    font-size: 0.85rem;
    width: 18px;
    text-align: center;
    color: var(--slate-dim);
    flex-shrink: 0;
  }

  .sb-footer {
    padding: 16px 20px 24px;
    border-top: 1px solid var(--steel);
    flex-shrink: 0;
  }

  .sb-cta {
    display: block;
    text-align: center;
    width: 100%;
    padding: 10px 0;
    font-size: 0.85rem;
  }

  .sb-byline {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--slate-dim);
    text-align: center;
    letter-spacing: 0.08em;
  }
  .sb-byline span { color: var(--signal-red); }

  .sb-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 199;
  }

  /* Mobile hamburger trigger is added by each page's header bar */
  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
    }
    .sidebar.open {
      transform: translateX(0);
    }
    .sb-close { display: block; }
    .sb-overlay.open { display: block; }
  }
</style>

<script is:inline>
  const sidebar = document.getElementById("sidebar");
  const overlay = document.getElementById("sbOverlay");
  const sbClose = document.getElementById("sbClose");
  const hamburger = document.getElementById("sbHamburger");

  function openSidebar() {
    sidebar && sidebar.classList.add("open");
    overlay && overlay.classList.add("open");
    document.body.style.overflow = "hidden";
  }
  function closeSidebar() {
    sidebar && sidebar.classList.remove("open");
    overlay && overlay.classList.remove("open");
    document.body.style.overflow = "";
  }

  hamburger && hamburger.addEventListener("click", openSidebar);
  sbClose && sbClose.addEventListener("click", closeSidebar);
  overlay && overlay.addEventListener("click", closeSidebar);
</script>
