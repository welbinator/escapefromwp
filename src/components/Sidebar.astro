---
import { execSync } from "child_process";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = Astro.url.pathname;
const commitHash = execSync("git rev-parse --short HEAD").toString().trim();

const is = (path: string) => url === base + path || url === base + path + "/";
const startsWith = (path: string) => url.startsWith(base + path);
---

<aside class="sidebar" id="sidebar">
  <!-- Logo -->
  <div class="sb-logo">
    <a href={`${base}/`} class="sb-wordmark">
      <span class="sb-bracket">[</span>EscapeFromWordPress<span class="sb-bracket">]</span>
    </a>
    <button class="sb-close" id="sbClose" aria-label="Close menu">✕</button>
  </div>

  <nav class="sb-nav">
    <div class="sb-section-label">Overview</div>
    <a href={`${base}/`} class:list={["sb-link", { active: is("/") }]}>Home</a>
    <a href={`${base}/#breakout`} class="sb-link">Get started</a>

    <div class="sb-section-label">Explore</div>
    <a href={`${base}/#prison`} class="sb-link">Why leave WordPress</a>
    <a href={`${base}/#plan`} class="sb-link">How it works</a>
    <a href={`${base}/#tiers`} class="sb-link">Pricing</a>

    <div class="sb-section-label">Resources</div>
    <a href={`${base}/evidence`} class:list={["sb-link", { active: startsWith("/evidence") }]}>Evidence</a>
    <a href={`${base}/stories`} class:list={["sb-link", { active: startsWith("/stories") }]}>Stories</a>
    <a href={`${base}/escapees`} class:list={["sb-link", { active: startsWith("/escapees") }]}>Who we've helped</a>

    <div class="sb-section-label">Tools</div>
    <a href={`${base}/liberate`} class:list={["sb-link", { active: startsWith("/liberate") }]}>Free preview</a>
  </nav>

  <!-- Footer: always pinned to bottom, padding NEVER changes -->
  <div class="sb-footer">
    <div class="sb-meta">
      <!--
        The button's left border IS the "vertical line".
        Only the chevron SVG flips — the line never moves.
      -->
      <button class="sb-collapse-btn" id="sbCollapseBtn" aria-label="Toggle sidebar">
        <svg class="sb-chevron-svg" viewBox="0 0 10 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="10" height="14">
          <polyline class="sb-chevron" points="7,2 3,7 7,12" />
        </svg>
      </button>
      <span class="sb-version">EscapeFromWP ({commitHash})</span>
    </div>
  </div>
</aside>

<!-- Overlay for mobile -->
<div class="sb-overlay" id="sbOverlay"></div>

<style>
  .sidebar {
    position: fixed;
    top: 0; left: 0;
    width: 260px;
    height: 100vh;
    background: var(--graphite);
    border-right: 1px solid var(--steel);
    display: flex;
    flex-direction: column;
    z-index: 200;
    overflow: hidden;
    transition: width 0.22s ease, transform 0.25s ease;
  }

  .sb-logo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--steel);
    flex-shrink: 0;
    min-height: 54px;
  }

  .sb-wordmark {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--chalk);
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    transition: opacity 0.15s;
  }
  .sb-wordmark:hover { color: var(--term-green); }
  .sb-bracket { color: var(--signal-red); }
  .sb-name-mobile { display: none; }

  .sb-close {
    display: none;
    background: none;
    border: none;
    color: var(--slate);
    cursor: pointer;
    font-size: 1rem;
    padding: 4px;
    flex-shrink: 0;
  }
  .sb-close:hover { color: var(--chalk); }

  /* flex:1 so footer is always pinned to bottom */
  .sb-nav {
    flex: 1;
    padding: 12px 0;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .sb-section-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-dim);
    padding: 14px 20px 4px;
    white-space: nowrap;
  }

  .sb-link {
    display: flex;
    align-items: center;
    padding: 9px 20px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--slate);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }
  .sb-link:hover { color: var(--chalk); background: rgba(255,255,255,0.04); }
  .sb-link.active { color: var(--term-green); background: rgba(78,227,107,0.07); }

  /* Footer — padding is identical open OR collapsed, never changes */
  .sb-footer {
    flex-shrink: 0;
    padding: 12px 20px 18px;
    border-top: 1px solid var(--steel);
  }

  .sb-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sb-version {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--slate-dim);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    transition: opacity 0.15s;
  }

  /* Button: left border = the fixed vertical "line" */
  .sb-collapse-btn {
    background: none;
    border: none;
    border-left: 2px solid var(--steel);
    color: var(--slate-dim);
    cursor: pointer;
    padding: 3px 6px 3px 8px;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: color 0.15s, border-color 0.15s;
  }
  .sb-collapse-btn:hover { color: var(--chalk); border-color: var(--slate); }

  /* Only the chevron flips; the left-border "line" never moves */
  .sb-chevron {
    transform-origin: 5px 7px;
    transition: transform 0.22s ease;
  }

  /* === Collapsed === */
  .sidebar.collapsed { width: 52px; }
  /* nav uses visibility:hidden (not display:none) so it keeps its flex space → footer stays pinned */
  .sidebar.collapsed .sb-nav { visibility: hidden; }
  .sidebar.collapsed .sb-version { opacity: 0; }
  /* wordmark clips naturally via sidebar overflow:hidden — shows just the [ bracket */
  .sidebar.collapsed .sb-logo { justify-content: flex-start; }
  /* chevron flips to point right → expand */
  .sidebar.collapsed .sb-chevron { transform: scaleX(-1); }

  .sb-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 199;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .sb-name-full { display: none; }
    .sb-name-mobile { display: inline; }

    /* Always full-width on mobile, never collapsed */
    .sidebar { transform: translateX(-100%); width: 260px !important; }
    .sidebar.open { transform: translateX(0); }

    /* Always show content on mobile regardless of desktop collapsed state */
    .sidebar .sb-nav { visibility: visible !important; }
    .sidebar .sb-wordmark { opacity: 1 !important; }
    .sidebar .sb-version { opacity: 1 !important; }
    .sidebar .sb-logo { justify-content: space-between !important; }

    .sb-close { display: block; }
    .sb-overlay.open { display: block; }
  }
</style>

<script is:inline>
  const sidebar = document.getElementById("sidebar");
  const overlay = document.getElementById("sbOverlay");
  const sbClose = document.getElementById("sbClose");
  const hamburger = document.getElementById("sbHamburger");
  const collapseBtn = document.getElementById("sbCollapseBtn");
  const mainContent = document.querySelector(".main-content");

  function openSidebar() {
    sidebar && sidebar.classList.add("open");
    overlay && overlay.classList.add("open");
    document.body.style.overflow = "hidden";
  }
  function closeSidebar() {
    sidebar && sidebar.classList.remove("open");
    overlay && overlay.classList.remove("open");
    document.body.style.overflow = "";
  }

  function applyCollapse(collapsed) {
    if (collapsed) {
      sidebar && sidebar.classList.add("collapsed");
      if (mainContent) mainContent.style.marginLeft = "52px";
    } else {
      sidebar && sidebar.classList.remove("collapsed");
      if (mainContent) mainContent.style.marginLeft = "260px";
    }
  }

  // Only restore collapsed state on desktop
  if (window.innerWidth > 768 && localStorage.getItem("sb-collapsed") === "1") {
    applyCollapse(true);
  }

  collapseBtn && collapseBtn.addEventListener("click", () => {
    if (window.innerWidth <= 768) return;
    const isCollapsed = sidebar && sidebar.classList.contains("collapsed");
    applyCollapse(!isCollapsed);
    localStorage.setItem("sb-collapsed", isCollapsed ? "0" : "1");
  });

  hamburger && hamburger.addEventListener("click", openSidebar);
  sbClose && sbClose.addEventListener("click", closeSidebar);
  overlay && overlay.addEventListener("click", closeSidebar);
</script>
