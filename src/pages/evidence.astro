---
import Layout from "../layouts/Layout.astro";
import { evidence, TYPE_LABEL, fmtDate, getSlug } from "../data/evidence.js";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Layout
  title="Why You Should Leave WordPress — The Evidence | Escape From WP"
  description="Thinking about leaving WordPress? Here's the evidence: real-world articles, posts, and security reports on WordPress hacks, plugin vulnerabilities, bloat, and maintenance pain — reasons you should get off WordPress and move to a faster, safer stack."
>

  <!-- PAGE HEADER -->
  <section class="container page-head">
    <span class="eyebrow danger rise">The evidence</span>
    <h1 class="page-title rise">Why people leave WordPress.</h1>
    <p class="section-lead rise">
      Not our opinion — real articles, security reports, and posts from across the web
      about WordPress hacks, plugin vulnerabilities, slow load times, and maintenance burnout.
      If you've been wondering whether leaving WordPress is the right call, start here.
    </p>
  </section>

  <!-- EVIDENCE GRID -->
  <section class="container">
    <div class="ev-grid">
      {evidence.map((e, i) => (
        <article
          class="ev-card rise is-clickable"
          data-ev
          data-title={e.title}
          data-type={TYPE_LABEL[e.type] || "Case file"}
          data-date={e.date ? fmtDate(e.date) : ""}
          data-source={e.source}
          data-summary={e.summary}
          data-url={e.url}
          data-slug={`${base}/evidence/${getSlug(e)}`}
          data-image={e.image ? `${base}${e.image}` : ""}
          data-exhibit={String(i + 1).padStart(2, "0")}
          tabindex="0"
          role="button"
          aria-label={`Read: ${e.title}`}
        >
          <div class="ev-media" aria-hidden="true">
            {e.image
              ? <img src={`${base}${e.image}`} alt={`${e.title} — featured image`} loading="lazy" />
              : (
                <div class="ev-nomedia">
                  <span class="ev-nomedia-no">EXHIBIT&nbsp;{String(i + 1).padStart(2, "0")}</span>
                  <span class="ev-nomedia-type">{TYPE_LABEL[e.type] || "Case file"}</span>
                  <span class="ev-nomedia-src">{e.source}</span>
                </div>
              )}
          </div>
          <div class="ev-body">
            <div class="ev-tags">
              <span class="ev-type">{TYPE_LABEL[e.type] || "Case file"}</span>
              {e.date && <span class="ev-date">{fmtDate(e.date)}</span>}
            </div>
            <h2 class="ev-title">{e.title}</h2>
            <p class="ev-summary">{e.summary.slice(0, 140)}{e.summary.length > 140 ? "…" : ""}</p>
            <div class="ev-foot">
              <span class="ev-src">{e.source}</span>
              <span class="ev-link">Read more ↗</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container breakout-cta rise">
    <h2 class="section-title">Seen enough?</h2>
    <p class="section-lead" style="max-width:48ch;margin:0 auto 28px;">
      See what your site looks like off WordPress — free, no commitment. Or get a free assessment and we'll give you a plain-English plan.
    </p>
    <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;">
      <a href={`${base}/liberate`} class="btn btn-ghost">▸ See a free preview</a>
      <a href={`${base}/#breakout`} class="btn btn-primary">▸ Get a free assessment</a>
    </div>
  </section>

  <!-- EVIDENCE MODAL -->
  <div class="modal-overlay" id="ev-modal" aria-hidden="true">
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="ev-modal-title">
      <button class="modal-close" id="ev-modal-close" aria-label="Close">✕</button>
      <div class="modal-body">
        <div class="modal-meta">
          <span class="ev-type" id="ev-modal-type"></span>
          <span class="ev-date" id="ev-modal-date"></span>
        </div>
        <h2 class="modal-title" id="ev-modal-title">—</h2>
        <p class="modal-source" id="ev-modal-source"></p>
        <div class="modal-summary" id="ev-modal-summary"></div>
        <div class="modal-links" id="ev-modal-links"></div>
        <div class="modal-cta">
          <p class="modal-cta-lead">Ready to get off WordPress?</p>
          <div class="modal-cta-btns">
            <a href={`${base}/liberate`} class="btn btn-ghost" style="font-size:13px;padding:10px 16px;">▸ See a free preview</a>
            <a href={`${base}/#breakout`} class="btn btn-primary" style="font-size:13px;padding:10px 16px;">▸ Get a free assessment</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container footer-inner">
      <span class="wordmark small">ESCAPE&nbsp;FROM&nbsp;<span class="wp">WP</span></span>
      <span class="footer-mono">WordPress migration &amp; rescue · escapefromwp.com</span>
      <span class="footer-mono dim">© {new Date().getFullYear()} — Your site deserves better.</span>
    </div>
  </footer>

  <style>
    /* NAV (shared with home page) */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(11, 4, 5, 0.72);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--steel);
    }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 62px; }
    .wordmark {
      font-family: var(--font-mono); font-weight: 700; font-size: 15px;
      letter-spacing: 0.06em; color: var(--chalk);
    }
    .wordmark .wp { color: var(--signal-red); }
    .wordmark.small { font-size: 13px; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a:not(.btn) {
      font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--slate); transition: color .15s;
    }
    .nav-links a:not(.btn):hover { color: var(--term-green); }
    .nav-links .active { color: var(--term-green); }
    .nav-cta { padding: 9px 16px; }

    /* HAMBURGER (hidden on desktop) */
    .nav-toggle {
      display: none; background: none; border: 1px solid var(--steel);
      width: 40px; height: 36px; cursor: pointer; padding: 0;
      flex-direction: column; align-items: center; justify-content: center; gap: 5px;
    }
    .nav-toggle-bar { display: block; width: 20px; height: 2px; background: var(--chalk); transition: transform .2s, opacity .2s; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* FOOTER (shared with home page) */
    .footer { border-top: 1px solid var(--steel); padding: 40px 0; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
    .footer-mono { font-family: var(--font-mono); font-size: 12px; color: var(--slate); letter-spacing: 0.04em; }
    .footer-mono.dim { color: var(--slate-dim); }

    .page-head { padding-top: 140px; padding-bottom: 24px; }
    .page-title { font-size: clamp(38px, 7vw, 72px); margin-bottom: 20px; line-height: 1.02; }

    /* EVIDENCE GRID */
    .ev-grid {
      display: grid; gap: 20px;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      padding-bottom: 40px;
    }
    .ev-card {
      border: 1px solid var(--steel); background: rgba(255,255,255,0.015);
      display: flex; flex-direction: column;
      transition: border-color .15s, transform .15s;
    }
    .ev-card.is-clickable { cursor: pointer; }
    .ev-card.is-clickable:hover { border-color: var(--term-green); transform: translateY(-2px); }
    .ev-card.is-clickable:focus-visible { outline: 2px solid var(--term-green); outline-offset: 2px; }

    /* MEDIA */
    .ev-media {
      position: relative; aspect-ratio: 1200 / 630; overflow: hidden;
      border-bottom: 1px solid var(--steel); background: #0b0405;
    }
    .ev-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ev-nomedia {
      width: 100%; height: 100%;
      display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end;
      gap: 6px; padding: 18px;
      background:
        repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 7px),
        linear-gradient(150deg, #150a0c 0%, #0b0405 60%);
    }
    .ev-nomedia::before {
      content: "NO IMAGE ON FILE";
      position: absolute; top: 16px; left: 18px;
      font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.22em;
      color: var(--slate-dim);
    }
    .ev-nomedia-no {
      font-family: var(--font-mono); font-weight: 700; font-size: 13px;
      letter-spacing: 0.22em; color: var(--signal-red);
    }
    .ev-nomedia-type {
      font-family: var(--font-display, inherit); font-size: 26px; font-weight: 700;
      line-height: 1.05; color: var(--chalk);
    }
    .ev-nomedia-src { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--term-green); }

    .ev-body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .ev-tags { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .ev-type {
      font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--term-green);
      border: 1px solid var(--steel); padding: 3px 8px;
    }
    .ev-date { font-family: var(--font-mono); font-size: 11px; color: var(--slate-dim); letter-spacing: 0.04em; }
    .ev-title { font-size: 20px; line-height: 1.2; color: var(--chalk); }
    .ev-summary { color: var(--slate); font-size: 15px; line-height: 1.55; flex: 1; }
    .ev-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 4px; flex-wrap: wrap; }
    .ev-src { font-family: var(--font-mono); font-size: 11px; color: var(--slate-dim); }
    .ev-link {
      font-family: var(--font-mono); font-size: 12px; color: var(--chalk);
      border-bottom: 1px solid var(--steel); transition: color .15s, border-color .15s;
    }
    .ev-card.is-clickable:hover .ev-link { color: var(--term-green); border-color: var(--term-green); }

    .breakout-cta { text-align: center; padding: 40px 0 90px; display: flex; flex-direction: column; align-items: center; gap: 22px; }

    /* MODAL */
    .modal-overlay {
      position: fixed; inset: 0; z-index: 200; display: none;
      align-items: center; justify-content: center; padding: 24px;
      background: rgba(0,0,0,0.78); backdrop-filter: blur(4px);
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      position: relative; width: 70vw; max-width: 780px; max-height: 86vh; overflow-y: auto;
      background: #0b0405; border: 1px solid var(--term-green);
      box-shadow: 0 0 0 1px rgba(78,227,107,0.15);
    }
    .modal-close {
      position: absolute; top: 12px; right: 12px; z-index: 2;
      background: rgba(0,0,0,0.6); border: 1px solid var(--steel); color: var(--chalk);
      width: 38px; height: 38px; cursor: pointer; font-size: 16px; line-height: 1;
      font-family: var(--font-mono); transition: border-color .15s, color .15s;
    }
    .modal-close:hover { border-color: var(--signal-red); color: var(--signal-red); }
    .modal-body { padding: 32px clamp(22px, 4vw, 44px) 36px; display: flex; flex-direction: column; gap: 14px; }
    .modal-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .modal-title { font-size: clamp(22px, 3.5vw, 36px); line-height: 1.1; }
    .modal-source { font-family: var(--font-mono); font-size: 12px; color: var(--term-green); letter-spacing: 0.04em; }
    .modal-summary { color: var(--slate); font-size: 16px; line-height: 1.72; margin-top: 4px; }
    .modal-links { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 6px; }
    .modal-links a {
      font-family: var(--font-mono); font-size: 13px; color: var(--chalk);
      border: 1px solid var(--steel); padding: 10px 16px; transition: border-color .15s, color .15s;
    }
    .modal-links a:hover { border-color: var(--term-green); color: var(--term-green); }
    .modal-cta {
      margin-top: 24px; padding-top: 20px;
      border-top: 1px solid var(--steel);
    }
    .modal-cta-lead {
      font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--slate); margin-bottom: 14px;
    }
    .modal-cta-btns { display: flex; gap: 12px; flex-wrap: wrap; }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      .nav-toggle { display: flex; }
      .nav-links {
        position: absolute; top: 62px; left: 0; right: 0;
        flex-direction: column; align-items: stretch; gap: 0;
        background: rgba(11, 4, 5, 0.97); backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--steel);
        max-height: 0; overflow: hidden; transition: max-height .25s ease;
      }
      .nav-links.open { max-height: 460px; }
      .nav-links a:not(.btn) { padding: 16px 20px; border-top: 1px solid var(--steel); }
      .nav-links .nav-cta { margin: 14px 20px 18px; text-align: center; }
    }
    @media (max-width: 640px) {
      .modal-box { width: 92vw; max-height: 90vh; }
      .ev-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script is:inline define:vars={{ base }}>
    // --- nav toggle ---
    const navToggle = document.querySelector(".nav-toggle");
    const navMenu = document.getElementById("nav-menu");
    if (navToggle && navMenu) {
      navToggle.addEventListener("click", () => {
        const open = navMenu.classList.toggle("open");
        navToggle.setAttribute("aria-expanded", open ? "true" : "false");
      });
      navMenu.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          navMenu.classList.remove("open");
          navToggle.setAttribute("aria-expanded", "false");
        })
      );
    }

    const esc = (s) => (s == null ? "" : String(s)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"));

    // --- MODAL ---
    const overlay  = document.getElementById("ev-modal");
    const mType    = document.getElementById("ev-modal-type");
    const mDate    = document.getElementById("ev-modal-date");
    const mTitle   = document.getElementById("ev-modal-title");
    const mSource  = document.getElementById("ev-modal-source");
    const mSummary = document.getElementById("ev-modal-summary");
    const mLinks   = document.getElementById("ev-modal-links");
    let lastFocused = null;

    function openModal(d) {
      lastFocused = document.activeElement;
      mType.textContent    = d.type || "";
      mDate.textContent    = d.date || "";
      mTitle.textContent   = d.title || "";
      mSource.textContent  = "Source: " + (d.source || "");
      mSummary.textContent = d.summary || "";

      let links = "";
      if (d.url)  links += `<a href="${esc(d.url)}" target="_blank" rel="noopener">▸ Read the source ↗</a>`;
      if (d.slug) links += `<a href="${esc(d.slug)}">View full page</a>`;
      mLinks.innerHTML = links;

      overlay.classList.add("open");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      document.getElementById("ev-modal-close").focus();
    }

    function closeModal() {
      overlay.classList.remove("open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocused) lastFocused.focus();
    }

    document.getElementById("ev-modal-close").addEventListener("click", closeModal);
    overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && overlay.classList.contains("open")) closeModal(); });

    function wireCard(el) {
      const open = () => openModal({
        type:    el.dataset.type,
        date:    el.dataset.date,
        title:   el.dataset.title,
        source:  el.dataset.source,
        summary: el.dataset.summary,
        url:     el.dataset.url,
        slug:    el.dataset.slug,
      });
      el.addEventListener("click", open);
      el.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(); } });
    }

    document.querySelectorAll("[data-ev]").forEach(wireCard);
  </script>
</Layout>
