---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Turnstile only renders when a public site key is provided at build time.
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---
<Layout
  title="See Your Site Rebuilt — Escape From WP"
  description="Paste your WordPress URL and we'll rebuild your site as a fast, self-contained exact copy on a modern stack — same look, your images and fonts, no WordPress. We email you the link in about a minute."
>
  <!-- NAV -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a href={`${base}/`} class="wordmark">
        ESCAPE&nbsp;FROM&nbsp;<span class="wp">WP</span>
      </a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <nav class="nav-links" id="nav-menu">
        <a href={`${base}/#prison`}>The Prison</a>
        <a href={`${base}/#plan`}>The Plan</a>
        <a href={`${base}/liberate`} class="active">Liberate</a>
        <a href={`${base}/evidence`}>Evidence</a>
        <a href={`${base}/escapees`}>Previous Prisoners</a>
        <a href={`${base}/#breakout`} class="btn btn-primary nav-cta">Plan your escape</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="wrap tool-hero rise">
    <span class="eyebrow">◦ Site mirror · 01</span>
    <h1 class="tool-title">Get an exact copy of your site — off WordPress.</h1>
    <p class="tool-lead">
      Paste your site's URL and we'll rebuild it as a fast, self-contained copy on a modern
      stack — <strong>the same look, the same content, no WordPress</strong>. We render every
      page, download your images and fonts, and host them on fast infrastructure that doesn't
      phone home to your old site. No login, no plugins, we never touch your live site.
      We email you a link when it's ready, usually in a minute or two.
    </p>
  </section>

  <!-- TOOL -->
  <section class="wrap tool-section rise">
    <form id="liberate-form" class="tool-form" novalidate>
      <div class="field">
        <label for="lf-url">Your WordPress site URL</label>
        <input id="lf-url" name="url" type="text" inputmode="url" autocomplete="url"
               placeholder="yoursite.com" required />
      </div>

      <div class="field">
        <label for="lf-email">Your email</label>
        <input id="lf-email" name="email" type="email" autocomplete="email"
               placeholder="you@example.com" required />
        <p class="field-hint">We send your rebuilt-site link here and may follow up about your migration. No spam.</p>
      </div>

      <!-- honeypot -->
      <input type="text" name="website_hp" tabindex="-1" autocomplete="off"
             style="position:absolute;left:-9999px;opacity:0;" aria-hidden="true" />

      {turnstileKey && (
        <div id="lf-turnstile" class="cf-turnstile" data-sitekey={turnstileKey} data-size="flexible"></div>
      )}

      <button type="submit" class="btn btn-primary tool-submit" id="lf-submit">
        ▸ Build my copy
      </button>
      <p class="tool-note">Free. This usually takes a minute or two while we rebuild your site. We email you the link when it's ready and never touch your live site.</p>
    </form>

    <!-- STATUS / RESULT -->
    <div id="lf-status" class="tool-status" hidden></div>
    <div id="lf-result" class="tool-result" hidden></div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="wrap how-section">
    <h2 class="how-head">How the breakout works</h2>
    <ol class="how-steps">
      <li>
        <span class="how-no">01</span>
        <div>
          <h3>We render your real site</h3>
          <p>We open your site in a real browser — just like a visitor — so every image, font, and piece of content loads exactly the way you see it. No login, no plugin, no access to your server.</p>
        </div>
      </li>
      <li>
        <span class="how-no">02</span>
        <div>
          <h3>We rebuild it off WordPress</h3>
          <p>We capture the fully-rendered page, download your images and fonts, and rehost everything on fast infrastructure. The result is a self-contained copy that looks the same but no longer depends on WordPress or your old host.</p>
        </div>
      </li>
      <li>
        <span class="how-no">03</span>
        <div>
          <h3>You get a live link</h3>
          <p>We email you a link to your rebuilt site — open it on your phone or desktop and see your site, running without WordPress. Like it? Reply and we'll put it on your own domain and take care of any changes.</p>
        </div>
      </li>
    </ol>
    <p class="how-foot">
      Don't want to DIY? <a href={`${base}/#breakout`}>Let us run the whole migration for you ↗</a>
    </p>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <span class="wordmark small">ESCAPE&nbsp;FROM&nbsp;<span class="wp">WP</span></span>
      <span class="footer-mono">◦ WordPress migration &amp; rescue · escapefromwp.com</span>
      <span class="footer-mono dim">© {new Date().getFullYear()} — All units accounted for.</span>
    </div>
  </footer>

  {turnstileKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <style>
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(11, 4, 5, 0.72); backdrop-filter: blur(10px); border-bottom: 1px solid var(--steel); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 62px; }
    .wordmark { font-family: var(--font-mono); font-weight: 700; font-size: 15px; letter-spacing: 0.06em; color: var(--chalk); }
    .wordmark .wp { color: var(--signal-red); }
    .wordmark.small { font-size: 13px; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a:not(.btn) { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--slate); transition: color .15s; }
    .nav-links a:not(.btn):hover { color: var(--term-green); }
    .nav-links .active { color: var(--term-green); }
    .nav-cta { padding: 9px 16px; }
    .nav-toggle { display: none; background: none; border: 1px solid var(--steel); width: 40px; height: 36px; cursor: pointer; padding: 0; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
    .nav-toggle-bar { display: block; width: 20px; height: 2px; background: var(--chalk); transition: transform .2s, opacity .2s; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .footer { border-top: 1px solid var(--steel); padding: 40px 0; margin-top: 40px; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
    .footer-mono { font-family: var(--font-mono); font-size: 12px; color: var(--slate); letter-spacing: 0.04em; }
    .footer-mono.dim { color: var(--slate-dim); }

    .tool-hero { padding-top: 120px; max-width: 760px; }
    .eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--term-green); display: block; margin-bottom: 16px; }
    .wip-badge { font-family: var(--font-mono); font-size: 12px; line-height: 1.5; color: #f6d08a; border: 1px solid rgba(246,208,138,0.4); background: rgba(246,208,138,0.06); padding: 10px 14px; margin-bottom: 20px; border-radius: 4px; }
    /* Animated loading indicator (preview build in progress) */
    .efw-loader { display: flex; align-items: center; gap: 18px; padding: 22px 20px; border: 1px solid var(--term-green); border-radius: 8px; background: rgba(74,222,128,0.06); box-shadow: 0 0 0 1px rgba(74,222,128,0.15), 0 10px 40px rgba(0,0,0,0.3); animation: efw-pulse 2.4s ease-in-out infinite; }
    .efw-spinner { width: 42px; height: 42px; border: 4px solid var(--steel); border-top-color: var(--term-green); border-radius: 50%; flex-shrink: 0; animation: efw-spin 0.8s linear infinite; }
    .efw-loader-text { display: flex; flex-direction: column; gap: 5px; }
    .efw-loader-text .lead { color: var(--chalk); font-weight: 600; font-size: 16px; }
    .efw-loader-text .sub { color: var(--slate-dim); font-size: 12px; }
    .efw-dots::after { content: ""; animation: efw-dots 1.4s steps(4,end) infinite; }
    @keyframes efw-spin { to { transform: rotate(360deg); } }
    @keyframes efw-pulse { 0%,100% { box-shadow: 0 0 0 1px rgba(74,222,128,0.15), 0 10px 40px rgba(0,0,0,0.3); } 50% { box-shadow: 0 0 0 1px rgba(74,222,128,0.4), 0 10px 40px rgba(0,0,0,0.3); } }
    @keyframes efw-dots { 0% { content: ""; } 25% { content: "."; } 50% { content: ".."; } 75% { content: "..."; } }
    @media (prefers-reduced-motion: reduce) { .efw-spinner { animation-duration: 2s; } .efw-loader { animation: none; } .efw-dots::after { animation: none; content: "…"; } }
    .tool-title { font-size: clamp(34px, 6vw, 60px); line-height: 1.02; margin-bottom: 18px; }
    .tool-lead { color: var(--slate); font-size: 18px; line-height: 1.6; }
    .tool-lead strong { color: var(--chalk); }

    .tool-section { max-width: 640px; padding-top: 36px; }
    .tool-form { display: flex; flex-direction: column; gap: 22px; border: 1px solid var(--steel); padding: 30px; background: rgba(255,255,255,0.015); }
    .field { display: flex; flex-direction: column; gap: 8px; }
    .field label { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--chalk); }
    .field input, .field select { background: #0b0405; border: 1px solid var(--steel); color: var(--chalk); padding: 13px 14px; font-family: var(--font-sans); font-size: 15px; border-radius: 0; transition: border-color .15s; width: 100%; }
    .field input:focus, .field select:focus { outline: none; border-color: var(--term-green); }
    .field input::placeholder { color: var(--slate-dim); }
    .select-wrap { position: relative; }
    .select-wrap::after { content: "▾"; position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: var(--term-green); pointer-events: none; font-size: 12px; }
    .field select { appearance: none; -webkit-appearance: none; cursor: pointer; padding-right: 36px; }
    .field-hint { font-family: var(--font-mono); font-size: 11px; color: var(--slate-dim); line-height: 1.5; }
    .field-hint code, .how-steps code, .tool-result code { font-family: var(--font-mono); color: var(--term-green); font-size: 0.92em; }
    .tool-submit { margin-top: 4px; width: 100%; justify-content: center; }
    .tool-note { font-family: var(--font-mono); font-size: 11px; color: var(--slate-dim); text-align: center; }
    .cf-turnstile { margin: 2px 0; }
    .tool-alt { max-width: 640px; margin: 14px auto 0; text-align: center; font-family: var(--font-mono); font-size: 12px; color: var(--slate-dim); }
    .linklike { background: none; border: none; color: var(--term-green); font-family: var(--font-mono); font-size: 12px; cursor: pointer; padding: 0; text-decoration: underline; text-underline-offset: 3px; }
    .linklike:hover { color: var(--chalk); }

    .tool-result :global(.prev-grid) { display: flex; flex-direction: column; gap: 12px; margin: 18px 0; }
    .tool-result :global(.prev-card) { display: flex; align-items: center; justify-content: space-between; gap: 14px; border: 1px solid var(--steel); padding: 16px 18px; background: rgba(255,255,255,0.015); transition: border-color .15s; text-decoration: none; }
    .tool-result :global(.prev-card:hover) { border-color: var(--term-green); }
    .tool-result :global(.prev-meta) { display: flex; flex-direction: column; gap: 3px; }
    .tool-result :global(.prev-name) { font-family: var(--font-sans); font-size: 16px; color: var(--chalk); font-weight: 600; }
    .tool-result :global(.prev-blurb) { font-family: var(--font-mono); font-size: 11px; color: var(--slate); }
    .tool-result :global(.prev-go) { font-family: var(--font-mono); font-size: 12px; color: var(--term-green); white-space: nowrap; }

    .tool-status { margin-top: 24px; border: 1px solid var(--steel); padding: 20px 22px; font-family: var(--font-mono); font-size: 13px; color: var(--slate); scroll-margin-top: 90px; }
    .tool-status .spin { color: var(--term-green); }
    .tool-status.error { border-color: var(--signal-red); color: #f6b8bd; }

    .tool-result { margin-top: 24px; border: 1px solid var(--term-green); padding: 26px; background: rgba(78,227,107,0.04); scroll-margin-top: 80px; }
    .tool-result :global(h2) { font-size: 20px; margin-bottom: 6px; color: var(--chalk); }
    .tool-result :global(.res-sub) { font-family: var(--font-mono); font-size: 12px; color: var(--slate); margin-bottom: 18px; }
    .tool-result :global(.res-table) { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-family: var(--font-mono); font-size: 13px; table-layout: fixed; }
    .tool-result :global(.res-table td) { padding: 8px 0; border-bottom: 1px solid var(--steel); color: var(--slate); vertical-align: top; line-height: 1.4; word-break: break-word; }
    .tool-result :global(.res-table td.n) { text-align: right; color: var(--chalk); width: 3.5em; padding-left: 12px; white-space: nowrap; }
    .tool-result :global(.res-table .res-type) { color: var(--slate-dim); }
    .tool-result :global(.res-table tr:last-child td) { border-bottom: none; }
    .tool-result :global(.res-total) { font-family: var(--font-mono); font-size: 13px; color: var(--term-green); margin-bottom: 18px; word-break: break-word; }
    .tool-result :global(.res-download) { display: flex; width: 100%; justify-content: center; text-align: center; font-size: 15px; padding: 15px 20px; margin-bottom: 14px; box-sizing: border-box; }
    .tool-result :global(.res-actions) { display: flex; flex-direction: column; gap: 10px; margin-bottom: 8px; }
    .tool-result :global(.res-actions .res-download) { margin-bottom: 0; }
    .tool-result :global(.btn-ghost) { display: flex; width: 100%; justify-content: center; align-items: center; gap: 9px; text-align: center; font-size: 13px; line-height: 1.35; padding: 15px 18px; box-sizing: border-box; background: transparent; color: var(--chalk); border: 1px solid var(--term-green); cursor: pointer; font-family: var(--font-mono); font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; white-space: normal; word-break: break-word; transition: background .15s, color .15s; }
    .tool-result :global(.btn-ghost:hover) { background: rgba(78,227,107,.12); }
    .tool-result :global(.btn-ghost:disabled) { cursor: default; opacity: .9; }
    .tool-result :global(.btn-ghost.building) { border-color: var(--steel); color: var(--slate); }
    .tool-result :global(.btn-ghost.ready) { background: var(--term-green); color: #06230f; border-color: var(--term-green); }
    .tool-result :global(.efw-btn-spin) { width: 15px; height: 15px; border: 2px solid var(--steel); border-top-color: var(--term-green); border-radius: 50%; display: inline-block; animation: efw-spin 0.8s linear infinite; flex-shrink: 0; }
    .tool-result :global(.res-zip-hint) { font-size: 13px; color: var(--slate); line-height: 1.6; margin: 0 0 16px; }
    .tool-result :global(.res-zip-hint strong) { color: var(--chalk); }
    .tool-result :global(.res-zip-hint code) { font-family: var(--font-mono); color: var(--term-green); font-size: 0.9em; }
    @media (prefers-reduced-motion: reduce) { .tool-result :global(.efw-btn-spin) { animation-duration: 2s; } }
    .tool-result :global(.res-expiry) { font-family: var(--font-mono); font-size: 12px; color: var(--slate); line-height: 1.6; }
    .tool-result :global(.res-expiry strong) { color: var(--chalk); }
    .tool-result :global(.res-notice) { font-family: var(--font-mono); font-size: 12px; color: #f6d08a; border-left: 2px solid #f6d08a; padding-left: 12px; margin-bottom: 18px; }
    .tool-result :global(.res-again) { display: inline-block; margin-top: 18px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--slate); cursor: pointer; background: none; border: 1px solid var(--steel); padding: 10px 16px; transition: border-color .15s, color .15s; }
    .tool-result :global(.res-again:hover) { border-color: var(--term-green); color: var(--term-green); }
    .tool-result :global(code) { font-family: var(--font-mono); color: var(--term-green); font-size: 0.92em; word-break: break-all; }

    .how-section { max-width: 760px; padding-top: 70px; }
    .how-head { font-size: clamp(24px, 4vw, 34px); margin-bottom: 30px; }
    .how-steps { list-style: none; display: flex; flex-direction: column; gap: 26px; }
    .how-steps li { display: flex; gap: 18px; align-items: flex-start; }
    .how-no { font-family: var(--font-mono); font-size: 13px; color: var(--term-green); border: 1px solid var(--steel); padding: 6px 9px; flex-shrink: 0; }
    .how-steps h3 { font-size: 17px; margin-bottom: 6px; }
    .how-steps p { color: var(--slate); font-size: 15px; line-height: 1.6; }
    .how-foot { margin-top: 34px; font-family: var(--font-mono); font-size: 13px; color: var(--slate); }
    .how-foot a { color: var(--term-green); }

    @media (max-width: 900px) {
      .nav-toggle { display: flex; }
      .nav-links { position: absolute; top: 62px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; background: rgba(11, 4, 5, 0.97); backdrop-filter: blur(10px); border-bottom: 1px solid var(--steel); max-height: 0; overflow: hidden; transition: max-height .25s ease; }
      .nav-links.open { max-height: 520px; }
      .nav-links a:not(.btn) { padding: 16px 20px; border-top: 1px solid var(--steel); }
      .nav-links .nav-cta { margin: 14px 20px 18px; text-align: center; }
      .tool-form { padding: 22px; }
    }
  </style>

  <script is:inline>
    // Mobile nav
    const navToggle = document.querySelector(".nav-toggle");
    const navMenu = document.getElementById("nav-menu");
    if (navToggle && navMenu) {
      navToggle.addEventListener("click", () => {
        const open = navMenu.classList.toggle("open");
        navToggle.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }

    const form = document.getElementById("liberate-form");
    const statusEl = document.getElementById("lf-status");
    const resultEl = document.getElementById("lf-result");
    const submitBtn = document.getElementById("lf-submit");
    const isPreview = /github\.io$/.test(location.hostname);

    // mode: "replica" (default, exact copy) | "zip" (raw content export)
    function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c])); }
    function apiBase() { return (location.pathname.replace(/\/liberate\/?$/, "") || ""); }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      resultEl.hidden = true;
      statusEl.hidden = false;
      statusEl.className = "tool-status";

      if (isPreview) {
        statusEl.className = "tool-status error";
        statusEl.textContent = "This is the staging preview — the tool only runs on the live site (escapefromwp.com).";
        return;
      }

      const tsToken = (window.turnstile && document.querySelector(".cf-turnstile"))
        ? (form.querySelector('[name="cf-turnstile-response"]') || {}).value || ""
        : "";

      const payload = {
        url: form.url.value.trim(),
        email: form.email.value.trim(),
        website_hp: form.website_hp.value,
        turnstile_token: tsToken,
      };
      if (!payload.url || !payload.email) {
        statusEl.className = "tool-status error";
        statusEl.textContent = "Please enter both your site URL and email.";
        return;
      }

      submitBtn.disabled = true;
      const siteLabel = esc(payload.url.replace(/^https?:\/\//, ""));

      try {
        await runReplica(payload, siteLabel);
      } catch (err) {
        statusEl.className = "tool-status error";
        statusEl.textContent = "✕ Something went wrong reaching the service. Please try again.";
        submitBtn.disabled = false;
      }
    });

    // ---- Exact-copy mirror (default) ------------------------------------
    async function runReplica(payload, siteLabel) {
      statusEl.innerHTML =
        '<div class="efw-loader">' +
          '<div class="efw-spinner"></div>' +
          '<div class="efw-loader-text">' +
            '<span class="lead">Rebuilding ' + siteLabel + ' off WordPress<span class="efw-dots"></span></span>' +
            '<span class="sub">We\'re rendering your site, downloading your images and fonts, and rehosting everything. This usually takes a minute or two — hang tight, or we\'ll email you the link when it\'s ready.</span>' +
          "</div>" +
        "</div>";
      // Firmly bring the loader into view near the top so it's unmistakable that
      // the build started (a tick lets layout settle after un-hiding the status).
      requestAnimationFrame(() => {
        const y = statusEl.getBoundingClientRect().top + window.pageYOffset - 90;
        window.scrollTo({ top: y, behavior: "smooth" });
      });

      const res = await fetch(apiBase() + "/api/replicate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      let data = null; try { data = await res.json(); } catch {}

      if (!res.ok || !data || !data.ok) {
        const msg = (data && data.error) || "We couldn't rebuild that URL. Please check it and try again.";
        statusEl.className = "tool-status error";
        statusEl.textContent = "✕ " + msg;
        statusEl.scrollIntoView({ behavior: "smooth", block: "center" });
        resetTurnstile();
        submitBtn.disabled = false;
        return;
      }

      // Poll the replica URL until it's built (or give up and lean on the email).
      const replicaUrl = data.url;
      const siteName = (data.site || siteLabel);
      let built = false;
      for (let i = 0; i < 40; i++) {
        await new Promise((r) => setTimeout(r, 6000));
        try {
          const probe = await fetch(replicaUrl, { method: "GET", cache: "no-store" });
          const txt = await probe.text();
          if (!/Rebuilding your site/i.test(txt)) { built = true; break; }
        } catch (_) {}
      }

      statusEl.hidden = true;
      resultEl.hidden = false;

      const previewId = data.preview_id;
      const emailLine = "We've emailed the link to <strong>" + esc(data.email) + "</strong> so you don't lose it.";
      const headline = built ? "✓ Your site has been rebuilt." : "✓ We're rebuilding your site.";
      const subline = built
        ? "Here's " + esc(siteName) + ", running without WordPress — same look, your images and fonts, hosted on fast infrastructure."
        : esc(siteName) + " is taking a little longer than usual to finish. Your link is ready to open — if you see a build screen, it refreshes itself.";
      const viewLabel = built ? "View my rebuilt site ↗" : "Open my rebuilt site ↗";

      resultEl.innerHTML =
        "<h2>" + headline + "</h2>" +
        '<p class="res-sub">' + subline + "</p>" +
        '<div class="res-actions">' +
          '<a class="btn btn-primary res-download" href="' + esc(replicaUrl) + '" target="_blank" rel="noopener">' + viewLabel + "</a>" +
          '<button type="button" class="btn btn-ghost res-zip-btn" id="lf-zip-btn">⬇ Generate the full EmDash site (.zip)</button>' +
        "</div>" +
        '<p class="res-zip-hint" id="lf-zip-hint">Prefer to build it yourself? Generate a ready-to-run EmDash project — your content baked in, plus an exact copy of your site to match the design.</p>' +
        '<p class="res-expiry">' + emailLine + " Like it? Reply to that email and we'll put it on your own domain and handle any changes you want.</p>" +
        '<button type="button" class="res-again" id="lf-again">↻ Rebuild another site</button>';

      resultEl.scrollIntoView({ behavior: "smooth", block: "start" });
      wireZipButton(previewId, siteName);
      wireAgain();
    }

    // ---- Full EmDash site (.zip) — triggered from the result card -----------
    // Reuses the already-created preview row: /api/replica-offer {choice:'no'}
    // enqueues the 'emdash-zip' worker job, then /api/zip-status is polled until
    // the zip + download token are ready.
    function wireZipButton(previewId, siteName) {
      const btn = document.getElementById("lf-zip-btn");
      const hint = document.getElementById("lf-zip-hint");
      if (!btn || !previewId) return;

      btn.addEventListener("click", async function () {
        btn.disabled = true;
        btn.classList.add("building");
        btn.innerHTML = '<span class="efw-btn-spin"></span> Building your EmDash site now…';
        if (hint) hint.textContent = "Packaging your content and an exact copy of your site into a ready-to-run EmDash project. This usually takes a minute or two — keep this page open.";

        // 1) Kick off the build (idempotent on the server).
        try {
          const kick = await fetch(apiBase() + "/api/replica-offer", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: previewId, choice: "no" }),
          });
          const kd = await kick.json().catch(() => ({}));
          if (!kick.ok || !kd.ok) {
            return zipError(btn, hint, (kd && kd.error) || "Couldn't start the export. Please try again.");
          }
        } catch (_) {
          return zipError(btn, hint, "Network error starting the export. Please try again.");
        }

        // 2) Poll for the finished zip (~up to 5 min).
        let downloadUrl = null;
        for (let i = 0; i < 50; i++) {
          await new Promise((r) => setTimeout(r, 6000));
          try {
            const s = await fetch(apiBase() + "/api/zip-status?id=" + encodeURIComponent(previewId), { cache: "no-store" });
            const sd = await s.json().catch(() => ({}));
            if (sd && sd.ok && sd.ready && sd.download_url) { downloadUrl = sd.download_url; break; }
          } catch (_) {}
        }

        if (!downloadUrl) {
          // Build is still running — the email will carry the link.
          btn.classList.remove("building");
          btn.innerHTML = "⬇ Still building — check your email";
          if (hint) hint.innerHTML = "Your EmDash site is taking a little longer. We'll <strong>email you the download link</strong> the moment it's ready (good for 24 hours).";
          return;
        }

        // 3) Done — swap the button out for a real download link (fresh element,
        // so the build click-listener is gone and a second tap just re-downloads).
        const dl = document.createElement("a");
        dl.className = "btn btn-ghost ready";
        dl.href = downloadUrl;
        dl.setAttribute("download", "");
        dl.textContent = "⬇ Download your EmDash site (.zip)";
        btn.replaceWith(dl);
        if (hint) hint.innerHTML = "✓ Ready! We've also <strong>emailed you this link</strong> so you don't lose it. It works for <strong>24 hours</strong>. Unzip it, open <code>README.md</code>, and follow the steps — or hand the folder to your AI coding assistant.";
      });
    }

    function zipError(btn, hint, msg) {
      btn.classList.remove("building");
      btn.disabled = false;
      btn.innerHTML = "⬇ Generate the full EmDash site (.zip)";
      if (hint) { hint.innerHTML = '<span style="color:#ff6b6b">✕ ' + esc(msg) + "</span>"; }
    }

    function resetTurnstile() { try { if (window.turnstile) window.turnstile.reset(); } catch (_) {} }
    function wireAgain() {
      const again = document.getElementById("lf-again");
      if (again) again.addEventListener("click", () => {
        resultEl.hidden = true;
        form.reset();
        resetTurnstile();
        submitBtn.disabled = false;
        window.scrollTo({ top: form.offsetTop - 120, behavior: "smooth" });
      });
    }
  </script>
</Layout>
