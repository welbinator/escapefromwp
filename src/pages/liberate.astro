---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Turnstile only renders when a public site key is provided at build time.
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";

const faqs = [
  ["How do I move my site from WordPress to EmDash?", "The fastest way is to paste your WordPress URL on this page. We render your live site, download your images and fonts, and rebuild it as a self-contained EmDash CMS copy, then email you a link. You can also migrate manually with EmDash's built-in WordPress importer, but this tool gives you a pixel-faithful copy of your existing design without any setup."],
  ["What is EmDash and why move off WordPress?", "EmDash is a modern CMS built on Astro that serves fast static pages instead of running PHP and a database on every request like WordPress. Moving from WordPress to EmDash means no plugins to update, a much smaller attack surface, and faster load times, while keeping a friendly admin for editing content."],
  ["Will my site look the same after moving to EmDash?", "Yes. We capture your fully-rendered pages exactly as a visitor sees them, so your EmDash copy keeps the same look, layout, images, and fonts. Nothing about your live WordPress site changes during the process."],
  ["Is the WordPress-to-EmDash rebuild free?", "Yes. Building your EmDash copy is free and we email you the link, usually within a minute or two. If you want it put on your own domain or need changes, reply to that email and we'll handle the full migration for you."],
  ["Does this touch or break my existing WordPress site?", "No. We never log in to your site or touch your server. We only view your public pages the way any visitor would, so your live WordPress site keeps running untouched while we build your EmDash copy."],
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([q, a]) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---
<Layout
  title="Move From WordPress to EmDash — Free Site Rebuild | Escape From WP"
  description="Moving from WordPress to EmDash? Paste your WordPress URL and we'll rebuild your site as a fast, self-contained EmDash CMS copy — same look, your images and fonts, no WordPress. Free, and we email you the link in about a minute."
>
  <!-- NAV -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a href={`${base}/`} class="wordmark">
        ESCAPE&nbsp;FROM&nbsp;<span class="wp">WP</span>
      </a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <nav class="nav-links" id="nav-menu">
        <a href={`${base}/#prison`}>The Prison</a>
        <a href={`${base}/#plan`}>The Plan</a>
        <a href={`${base}/liberate`} class="active">Liberate</a>
        <a href={`${base}/evidence`}>Evidence</a>
        <a href={`${base}/escapees`}>Previous Prisoners</a>
        <a href={`${base}/#breakout`} class="btn btn-primary nav-cta">Plan your escape</a>
      </nav>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="wrap hero-section rise">
    <h1 class="tool-title">Move your site from WordPress to EmDash.</h1>
    <p class="tool-lead">
      Liberate your content from the confines of WordPress, and set it free.
    </p>

    <form id="liberate-form" class="tool-form" novalidate>
      <div class="field">
        <label for="lf-url">Your WordPress site URL</label>
        <div class="input-inline-wrap">
          <input id="lf-url" name="url" type="text" inputmode="url" autocomplete="url"
                 placeholder="yoursite.com" required />
          <button type="submit" class="btn btn-primary tool-submit" id="lf-submit">
            ▸ Build my copy
          </button>
        </div>
        <p class="field-hint">Enter the WordPress site you want moved to EmDash.</p>
      </div>

      <!-- honeypot -->
      <input type="text" name="website_hp" tabindex="-1" autocomplete="off"
             style="position:absolute;left:-9999px;opacity:0;" aria-hidden="true" />

      {turnstileKey && (
        <div id="lf-turnstile" class="cf-turnstile" data-sitekey={turnstileKey} data-size="flexible"></div>
      )}
    </form>

    <!-- STATUS / RESULT -->
    <div id="lf-status" class="tool-status" hidden></div>
    <div id="lf-result" class="tool-result" hidden></div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="wrap how-section">
    <h2 class="how-head">How the breakout works</h2>
    <ol class="how-steps">
      <li>
        <span class="how-no">01</span>
        <div>
          <h3>We render your real site</h3>
          <p>We open your site in a real browser — just like a visitor — so every image, font, and piece of content loads exactly the way you see it. No login, no plugin, no access to your server.</p>
        </div>
      </li>
      <li>
        <span class="how-no">02</span>
        <div>
          <h3>We rebuild it as an EmDash site</h3>
          <p>We capture the fully-rendered page, download your images and fonts, and rehost everything on fast infrastructure as a self-contained EmDash CMS copy. The result looks the same but no longer depends on WordPress, plugins, or your old host.</p>
        </div>
      </li>
      <li>
        <span class="how-no">03</span>
        <div>
          <h3>You get a live link to your EmDash copy</h3>
          <p>We email you a link to your rebuilt site — open it on your phone or desktop and see your site running on EmDash instead of WordPress. Like it? Reply and we'll put it on your own domain and take care of any changes.</p>
        </div>
      </li>
    </ol>
    <p class="how-foot">
      Don't want to DIY? <a href={`${base}/#breakout`}>Let us run the whole WordPress-to-EmDash migration for you ↗</a>
    </p>
  </section>

  <!-- FAQ (SEO: WordPress to EmDash) -->
  <section class="wrap faq-section rise">
    <h2 class="how-head">WordPress to EmDash: common questions</h2>
    <div class="faq-list">
      {faqs.map(([q, a]) => (
        <div class="faq-item">
          <h3>{q}</h3>
          <p>{a}</p>
        </div>
      ))}
    </div>
  </section>

  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <span class="wordmark small">ESCAPE&nbsp;FROM&nbsp;<span class="wp">WP</span></span>
      <span class="footer-mono">◦ WordPress migration &amp; rescue · escapefromwp.com</span>
      <span class="footer-mono dim">© {new Date().getFullYear()} — All units accounted for.</span>
      <a class="footer-mono dim footer-privacy" href="/privacy/">Privacy</a>
    </div>
  </footer>

  {turnstileKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <style>
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(11, 4, 5, 0.72); backdrop-filter: blur(10px); border-bottom: 1px solid var(--steel); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 62px; }
    .wordmark { font-family: var(--font-mono); font-weight: 700; font-size: 15px; letter-spacing: 0.06em; color: var(--chalk); }
    .wordmark .wp { color: var(--signal-red); }
    .wordmark.small { font-size: 13px; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a:not(.btn) { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--slate); transition: color .15s; }
    .nav-links a:not(.btn):hover { color: var(--term-green); }
    .nav-links .active { color: var(--term-green); }
    .nav-cta { padding: 9px 16px; }
    .nav-toggle { display: none; background: none; border: 1px solid var(--steel); width: 40px; height: 36px; cursor: pointer; padding: 0; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
    .nav-toggle-bar { display: block; width: 20px; height: 2px; background: var(--chalk); transition: transform .2s, opacity .2s; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .footer { border-top: 1px solid var(--steel); padding: 40px 0; margin-top: 40px; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; }

    :root {
      --section-maxw: 1200px;
    }

    .hero-section,
    .how-section,
    .faq-section {
      width: 100%;
      max-width: var(--section-maxw, 1200px);
    }

    .hero-section {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 90px;
      padding-bottom: 50px;
    }

    .faq-section { padding-top: 20px; }
    .faq-list { display: flex; flex-direction: column; gap: 22px; margin-top: 24px; }
    .faq-item { border: 1px solid var(--steel); padding: 20px 22px; background: rgba(255,255,255,0.015); }
    .faq-item h3 { font-size: 18px; margin-bottom: 8px; color: var(--chalk); }
    .faq-item p { color: var(--slate); font-size: 15px; line-height: 1.6; }
    .footer-mono { font-family: var(--font-mono); font-size: 12px; color: var(--slate); letter-spacing: 0.04em; }
    .footer-mono.dim { color: var(--slate-dim); }

    .eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--term-green); display: block; margin-bottom: 16px; }
    .wip-badge { font-family: var(--font-mono); font-size: 12px; line-height: 1.5; color: #f6d08a; border: 1px solid rgba(246,208,138,0.4); background: rgba(246,208,138,0.06); padding: 10px 14px; margin-bottom: 20px; border-radius: 4px; }
    /* NOTE: the build-in-progress loader CSS lives in a SEPARATE <style is:global>
       block below. It must be global because the loader markup is injected at
       runtime via innerHTML — Astro's scoped styles only match elements present in
       the template at build time, so scoped rules here would be tree-shaken away
       (which is exactly why the spinner was invisible and the text unstyled). */
    .tool-title { font-size: clamp(34px, 6vw, 60px); line-height: 1.02; margin-bottom: 18px; }
    .tool-lead { color: var(--slate); font-size: 18px; line-height: 1.6; margin-bottom: 28px; }
    .tool-lead strong { color: var(--chalk); }

    .tool-form { display: flex; flex-direction: column; gap: 16px; border: none; padding: 0; background: transparent; }
    .input-inline-wrap { display: flex; align-items: stretch; gap: 12px; width: 100%; }
    .input-inline-wrap input { flex: 1 1 auto; min-width: 0; }
    .input-inline-wrap .tool-submit { margin-top: 0; width: auto; white-space: nowrap; padding: 13px 26px; flex: 0 0 auto; }
    @media (max-width: 640px) {
      .input-inline-wrap { flex-direction: column; gap: 10px; }
      .input-inline-wrap .tool-submit { width: 100%; justify-content: center; }
    }
    .field { display: flex; flex-direction: column; gap: 8px; }
    .field label { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--chalk); }
    .field input, .field select { background: #0b0405; border: 1px solid var(--steel); color: var(--chalk); padding: 13px 14px; font-family: var(--font-sans); font-size: 15px; border-radius: 0; transition: border-color .15s; width: 100%; }
    .field input:focus, .field select:focus { outline: none; border-color: var(--term-green); }
    .field input::placeholder { color: var(--slate-dim); }
    .select-wrap { position: relative; }
    .select-wrap::after { content: "▾"; position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: var(--term-green); pointer-events: none; font-size: 12px; }
    .field select { appearance: none; -webkit-appearance: none; cursor: pointer; padding-right: 36px; }
    .field-hint { font-family: var(--font-mono); font-size: 11px; color: var(--slate-dim); line-height: 1.5; }
    .field-hint code, .how-steps code, .tool-result code { font-family: var(--font-mono); color: var(--term-green); font-size: 0.92em; }
    .tool-submit { margin-top: 4px; width: 100%; justify-content: center; }
    .optin, .tool-result :global(.optin) { display: flex; align-items: flex-start; gap: 10px; margin: 8px 0 12px; cursor: pointer; font-size: 13px; line-height: 1.45; color: var(--chalk); }
    .optin input, .tool-result :global(.optin input) { width: 17px; height: 17px; margin: 1px 0 0; flex-shrink: 0; accent-color: var(--term-green); cursor: pointer; }
    .optin span, .tool-result :global(.optin span) { color: var(--mist, #b8b0b2); }
    .tool-note { font-family: var(--font-mono); font-size: 11px; color: var(--slate-dim); text-align: center; }
    .cf-turnstile { margin: 2px 0; }
    .tool-alt { max-width: 640px; margin: 14px auto 0; text-align: center; font-family: var(--font-mono); font-size: 12px; color: var(--slate-dim); }
    .linklike { background: none; border: none; color: var(--term-green); font-family: var(--font-mono); font-size: 12px; cursor: pointer; padding: 0; text-decoration: underline; text-underline-offset: 3px; }
    .linklike:hover { color: var(--chalk); }

    .tool-result :global(.prev-grid) { display: flex; flex-direction: column; gap: 12px; margin: 18px 0; }
    .tool-result :global(.prev-card) { display: flex; align-items: center; justify-content: space-between; gap: 14px; border: 1px solid var(--steel); padding: 16px 18px; background: rgba(255,255,255,0.015); transition: border-color .15s; text-decoration: none; }
    .tool-result :global(.prev-card:hover) { border-color: var(--term-green); }
    .tool-result :global(.prev-meta) { display: flex; flex-direction: column; gap: 3px; }
    .tool-result :global(.prev-name) { font-family: var(--font-sans); font-size: 16px; color: var(--chalk); font-weight: 600; }
    .tool-result :global(.prev-blurb) { font-family: var(--font-mono); font-size: 11px; color: var(--slate); }
    .tool-result :global(.prev-go) { font-family: var(--font-mono); font-size: 12px; color: var(--term-green); white-space: nowrap; }

    .tool-status { margin-top: 24px; border: 1px solid var(--steel); padding: 20px 22px; font-family: var(--font-mono); font-size: 13px; color: var(--slate); scroll-margin-top: 90px; }
    .tool-status .spin { color: var(--term-green); }
    .tool-status.error { border-color: var(--signal-red); color: #f6b8bd; }

    .tool-result { margin-top: 24px; border: 1px solid var(--term-green); padding: 26px; background: rgba(78,227,107,0.04); scroll-margin-top: 80px; }
    .tool-result :global(h2) { font-size: 20px; margin-bottom: 6px; color: var(--chalk); }
    .tool-result :global(.res-sub) { font-family: var(--font-mono); font-size: 12px; color: var(--slate); margin-bottom: 18px; }
    .tool-result :global(.res-table) { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-family: var(--font-mono); font-size: 13px; table-layout: fixed; }
    .tool-result :global(.res-table td) { padding: 8px 0; border-bottom: 1px solid var(--steel); color: var(--slate); vertical-align: top; line-height: 1.4; word-break: break-word; }
    .tool-result :global(.res-table td.n) { text-align: right; color: var(--chalk); width: 3.5em; padding-left: 12px; white-space: nowrap; }
    .tool-result :global(.res-table .res-type) { color: var(--slate-dim); }
    .tool-result :global(.res-table tr:last-child td) { border-bottom: none; }
    .tool-result :global(.res-total) { font-family: var(--font-mono); font-size: 13px; color: var(--term-green); margin-bottom: 18px; word-break: break-word; }
    .tool-result :global(.res-download) { display: flex; width: 100%; justify-content: center; text-align: center; font-size: 15px; padding: 15px 20px; margin-bottom: 14px; box-sizing: border-box; }
    .tool-result :global(.res-actions) { display: flex; flex-direction: column; gap: 10px; margin-bottom: 8px; }
    .tool-result :global(.res-actions .res-download) { margin-bottom: 0; }
    .tool-result :global(.btn-ghost) { display: flex; width: 100%; justify-content: center; align-items: center; gap: 9px; text-align: center; font-size: 15px; line-height: 1.35; padding: 15px 20px; box-sizing: border-box; background: transparent; color: var(--chalk); border: 1px solid var(--term-green); border-radius: var(--radius); cursor: pointer; font-family: var(--font-mono); font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; white-space: normal; word-break: break-word; transition: background .15s, color .15s; }
    .tool-result :global(.btn-ghost:hover) { background: rgba(78,227,107,.12); }
    .tool-result :global(.btn-ghost:disabled) { cursor: default; opacity: .9; }
    .tool-result :global(.btn-ghost.building) { border-color: var(--steel); color: var(--slate); }
    .tool-result :global(.btn-ghost.ready) { background: var(--term-green); color: #06230f; border-color: var(--term-green); }
    .tool-result :global(.res-zip-group) { display: flex; flex-direction: column; gap: 8px; }
    .tool-result :global(.res-zip-row) { display: flex; align-items: stretch; gap: 10px; flex-wrap: wrap; }
    .tool-result :global(.res-zip-label) { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; color: var(--chalk); }
    .tool-result :global(.res-zip-field) { position: relative; display: block; flex: 1 1 auto; min-width: 0; }
    .tool-result :global(.res-zip-field::after) { content: "\25BE"; position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: var(--slate); font-size: 12px; pointer-events: none; }
    .tool-result :global(.res-zip-select) { -webkit-appearance: none; -moz-appearance: none; appearance: none; width: 100%; box-sizing: border-box; background: rgba(255,255,255,0.03); color: var(--chalk); border: 1px solid var(--steel); font-family: var(--font-mono); font-size: 14px; text-align: left; padding: 13px 38px 13px 16px; cursor: pointer; border-radius: var(--radius); transition: border-color .15s; }
    .tool-result :global(.res-zip-select:hover) { border-color: var(--steel-lit); }
    .tool-result :global(.res-zip-select:focus) { outline: none; border-color: var(--slate); }
    .tool-result :global(.res-zip-select:disabled) { opacity: .6; cursor: default; }
    .tool-result :global(.res-zip-select option) { background: #140d0e; color: #f3efe9; }
    .tool-result :global(.res-zip-group .res-zip-btn) { flex: 1 1 auto; width: auto; white-space: normal; padding-left: 18px; padding-right: 18px; }
    .tool-result :global(.res-zip-field) { flex: 1 1 100%; }
    .tool-result :global(.res-zip-btn-alt) { opacity: .82; }
    .tool-result :global(.res-zip-btn-alt:hover) { opacity: 1; }
    .tool-result :global(.efw-btn-spin) { width: 15px; height: 15px; border: 2px solid var(--steel); border-top-color: var(--term-green); border-radius: 50%; display: inline-block; animation: efw-spin 0.8s linear infinite; flex-shrink: 0; }
    .tool-result :global(.res-zip-hint) { font-size: 13px; color: var(--slate); line-height: 1.6; margin: 0 0 16px; }
    .tool-result :global(.res-zip-hint strong) { color: var(--chalk); }
    .tool-result :global(.res-zip-hint code) { font-family: var(--font-mono); color: var(--term-green); font-size: 0.9em; }
    @media (prefers-reduced-motion: reduce) { .tool-result :global(.efw-btn-spin) { animation-duration: 2s; } }
    .tool-result :global(.res-expiry) { font-family: var(--font-mono); font-size: 12px; color: var(--slate); line-height: 1.6; }
    .tool-result :global(.res-expiry strong) { color: var(--chalk); }
    .tool-result :global(.res-notice) { font-family: var(--font-mono); font-size: 12px; color: #f6d08a; border-left: 2px solid #f6d08a; padding-left: 12px; margin-bottom: 18px; }
    .tool-result :global(.res-again) { display: flex; width: 100%; justify-content: center; align-items: center; gap: 9px; box-sizing: border-box; margin-top: 18px; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.03em; text-transform: uppercase; font-weight: 600; color: var(--slate); cursor: pointer; background: none; border: 1px solid var(--steel); border-radius: var(--radius); padding: 15px 20px; transition: border-color .15s, color .15s; }
    .tool-result :global(.res-again:hover) { border-color: var(--term-green); color: var(--term-green); }
    .tool-result :global(code) { font-family: var(--font-mono); color: var(--term-green); font-size: 0.92em; word-break: break-all; }

    .tool-result :global(.res-zip-email-wrap) { display: flex; flex-direction: column; gap: 6px; margin: 4px 0 10px; }
    .tool-result :global(.res-zip-email-label) { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--chalk); }
    .tool-result :global(.res-zip-email) { width: 100%; box-sizing: border-box; background: rgba(255,255,255,0.03); color: var(--chalk); border: 1px solid var(--steel); font-family: var(--font-sans); font-size: 14px; padding: 12px 14px; border-radius: var(--radius); transition: border-color .15s; }
    .tool-result :global(.res-zip-email:focus) { outline: none; border-color: var(--term-green); }
    .tool-result :global(.res-zip-email.input-error) { border-color: var(--signal-red); }

    .how-section { padding-top: 70px; }
    .how-head { font-size: clamp(24px, 4vw, 34px); margin-bottom: 30px; }
    .how-steps { list-style: none; display: flex; flex-direction: column; gap: 26px; }
    .how-steps li { display: flex; gap: 18px; align-items: flex-start; }
    .how-no { font-family: var(--font-mono); font-size: 13px; color: var(--term-green); border: 1px solid var(--steel); padding: 6px 9px; flex-shrink: 0; }
    .how-steps h3 { font-size: 17px; margin-bottom: 6px; }
    .how-steps p { color: var(--slate); font-size: 15px; line-height: 1.6; }
    .how-foot { margin-top: 34px; font-family: var(--font-mono); font-size: 13px; color: var(--slate); }
    .how-foot a { color: var(--term-green); }

    @media (max-width: 900px) {
      .nav-toggle { display: flex; }
      .nav-links { position: absolute; top: 62px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; background: rgba(11, 4, 5, 0.97); backdrop-filter: blur(10px); border-bottom: 1px solid var(--steel); max-height: 0; overflow: hidden; transition: max-height .25s ease; }
      .nav-links.open { max-height: 520px; }
      .nav-links a:not(.btn) { padding: 16px 20px; border-top: 1px solid var(--steel); }
      .nav-links .nav-cta { margin: 14px 20px 18px; text-align: center; }
    }
  </style>

  <!-- Global loader styles — MUST be is:global because the loader markup is injected
       at runtime via innerHTML (see note in the scoped <style> above). -->
  <style is:global>
    .efw-loader { display: flex; align-items: center; gap: 18px; padding: 22px 20px; border: 1px solid var(--term-green); border-radius: 8px; background: rgba(74,222,128,0.06); box-shadow: 0 0 0 1px rgba(74,222,128,0.15), 0 10px 40px rgba(0,0,0,0.3); animation: efw-pulse 2.4s ease-in-out infinite; }
    .efw-spinner { width: 42px; height: 42px; border: 4px solid var(--steel); border-top-color: var(--term-green); border-radius: 50%; flex-shrink: 0; animation: efw-spin 0.8s linear infinite; }
    .efw-loader-text { display: flex; flex-direction: column; gap: 5px; }
    .efw-loader-text .lead { color: var(--chalk); font-weight: 600; font-size: 16px; }
    .efw-loader-text .sub { color: var(--slate-dim); font-size: 12px; line-height: 1.5; }
    .efw-dots::after { content: ""; animation: efw-dots 1.4s steps(4,end) infinite; }
    @keyframes efw-spin { to { transform: rotate(360deg); } }
    @keyframes efw-pulse { 0%,100% { box-shadow: 0 0 0 1px rgba(74,222,128,0.15), 0 10px 40px rgba(0,0,0,0.3); } 50% { box-shadow: 0 0 0 1px rgba(74,222,128,0.4), 0 10px 40px rgba(0,0,0,0.3); } }
    @keyframes efw-dots { 0% { content: ""; } 25% { content: "."; } 50% { content: ".."; } 75% { content: "..."; } }
    @media (prefers-reduced-motion: reduce) { .efw-spinner { animation-duration: 2s; } .efw-loader { animation: none; } .efw-dots::after { animation: none; content: "…"; } }
  </style>

  <script is:inline>
    // Mobile nav
    const navToggle = document.querySelector(".nav-toggle");
    const navMenu = document.getElementById("nav-menu");
    if (navToggle && navMenu) {
      navToggle.addEventListener("click", () => {
        const open = navMenu.classList.toggle("open");
        navToggle.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }

    const form = document.getElementById("liberate-form");
    const statusEl = document.getElementById("lf-status");
    const resultEl = document.getElementById("lf-result");
    const submitBtn = document.getElementById("lf-submit");
    const isPreview = /github\.io$/.test(location.hostname);

    // mode: "replica" (default, exact copy) | "zip" (raw content export)
    function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c])); }
    function apiBase() { return (location.pathname.replace(/\/liberate\/?$/, "") || ""); }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      resultEl.hidden = true;
      statusEl.hidden = false;
      statusEl.className = "tool-status";

      if (isPreview) {
        statusEl.className = "tool-status error";
        statusEl.textContent = "This is the staging preview — the tool only runs on the live site (escapefromwp.com).";
        return;
      }

      const tsToken = (window.turnstile && document.querySelector(".cf-turnstile"))
        ? (form.querySelector('[name="cf-turnstile-response"]') || {}).value || ""
        : "";

      const payload = {
        url: form.url.value.trim(),
        website_hp: form.website_hp.value,
        turnstile_token: tsToken,
      };
      if (!payload.url) {
        statusEl.className = "tool-status error";
        statusEl.textContent = "Please enter your WordPress site URL.";
        return;
      }

      submitBtn.disabled = true;
      const siteLabel = esc(payload.url.replace(/^https?:\/\//, ""));

      try {
        await runReplica(payload, siteLabel);
      } catch (err) {
        statusEl.className = "tool-status error";
        statusEl.textContent = "✕ Something went wrong reaching the service. Please try again.";
        submitBtn.disabled = false;
      }
    });

    // ---- Exact-copy mirror (default) ------------------------------------
    async function runReplica(payload, siteLabel) {
      // Self-styling loader: inline styles + injected keyframes so it renders correctly
      // even if the external stylesheet is cached/stale/stripped (don't rely on .efw-* CSS).
      if (!document.getElementById('efw-loader-kf')) {
        const kf = document.createElement('style');
        kf.id = 'efw-loader-kf';
        kf.textContent =
          '@keyframes efw-spin{to{transform:rotate(360deg)}}' +
          '@keyframes efw-pulse{0%,100%{box-shadow:0 0 0 1px rgba(74,222,128,.15),0 10px 40px rgba(0,0,0,.3)}50%{box-shadow:0 0 0 1px rgba(74,222,128,.4),0 10px 40px rgba(0,0,0,.3)}}' +
          '@keyframes efw-dots{0%{content:""}25%{content:"."}50%{content:".."}75%{content:"..."}}' +
          '.efw-dots::after{content:"";animation:efw-dots 1.4s steps(4,end) infinite}';
        document.head.appendChild(kf);
      }
      var SP = 'width:42px;height:42px;border:4px solid #382e30;border-top-color:#4ee36b;border-radius:50%;flex-shrink:0;animation:efw-spin .8s linear infinite';
      var LD = 'display:flex;align-items:center;gap:18px;padding:22px 20px;border:1px solid #4ee36b;border-radius:8px;background:rgba(74,222,128,.06);box-shadow:0 0 0 1px rgba(74,222,128,.15),0 10px 40px rgba(0,0,0,.3);animation:efw-pulse 2.4s ease-in-out infinite';
      statusEl.innerHTML =
        '<div class="efw-loader" style="' + LD + '">' +
          '<div class="efw-spinner" style="' + SP + '"></div>' +
          '<div class="efw-loader-text" style="display:flex;flex-direction:column;gap:5px">' +
            '<span class="lead" style="color:#f3efe9;font-weight:600;font-size:16px">Rebuilding ' + siteLabel + ' off WordPress<span class="efw-dots"></span></span>' +
            '<span class="sub" style="color:#6f686a;font-size:12px;line-height:1.5">We\'re rendering your site, downloading your images and fonts, and rehosting everything. This usually takes a minute or two — hang tight!</span>' +
          "</div>" +
        "</div>";
      // Firmly bring the loader into view near the top so it's unmistakable that
      // the build started (a tick lets layout settle after un-hiding the status).
      requestAnimationFrame(() => {
        const y = statusEl.getBoundingClientRect().top + window.pageYOffset - 90;
        window.scrollTo({ top: y, behavior: "smooth" });
      });

      const res = await fetch(apiBase() + "/api/replicate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      let data = null; try { data = await res.json(); } catch {}

      if (!res.ok || !data || !data.ok) {
        const msg = (data && data.error) || "We couldn't rebuild that URL. Please check it and try again.";
        statusEl.className = "tool-status error";
        statusEl.textContent = "✕ " + msg;
        statusEl.scrollIntoView({ behavior: "smooth", block: "center" });
        resetTurnstile();
        submitBtn.disabled = false;
        return;
      }

      // Poll the replica URL until it's built (or give up and lean on the email).
      const replicaUrl = data.url;
      const siteName = (data.site || siteLabel);
      let built = false;
      for (let i = 0; i < 40; i++) {
        await new Promise((r) => setTimeout(r, 6000));
        try {
          const probe = await fetch(replicaUrl, { method: "GET", cache: "no-store" });
          const txt = await probe.text();
          if (!/Rebuilding your site/i.test(txt)) { built = true; break; }
        } catch (_) {}
      }

      statusEl.hidden = true;
      resultEl.hidden = false;

      const previewId = data.preview_id;
      const headline = built ? "✓ Your site has been rebuilt." : "✓ We're rebuilding your site.";
      const subline = built
        ? "Here's " + esc(siteName) + ", running without WordPress — same look, your images and fonts, hosted on fast infrastructure."
        : esc(siteName) + " is taking a little longer than usual to finish. Your link is ready to open — if you see a build screen, it refreshes itself.";
      const viewLabel = built ? "View my rebuilt site ↗" : "Open my rebuilt site ↗";

      resultEl.innerHTML =
        "<h2>" + headline + "</h2>" +
        '<p class="res-sub">' + subline + "</p>" +
        '<div class="res-actions">' +
          '<a class="btn btn-primary res-download" href="' + esc(replicaUrl) + '" target="_blank" rel="noopener">' + viewLabel + "</a>" +
          '<span class="res-zip-group">' +
            '<label class="res-zip-label" for="lf-zip-target">Build a downloadable site (.zip)</label>' +
            '<div class="res-zip-email-wrap">' +
              '<label class="res-zip-email-label" for="lf-zip-email">Where should we email your download link?</label>' +
              '<input type="email" id="lf-zip-email" class="res-zip-email" placeholder="you@example.com" autocomplete="email" required />' +
              '<label class="optin" for="lf-zip-optin">' +
                '<input type="checkbox" id="lf-zip-optin" name="optin" checked />' +
                '<span>It\'s OK to email me about getting my site off WordPress.</span>' +
              '</label>' +
            "</div>" +
            '<span class="res-zip-row">' +
              '<span class="res-zip-field">' +
                '<select class="res-zip-select" id="lf-zip-target" aria-label="Choose site format">' +
                  '<option value="emdash">EmDash (CMS)</option>' +
                  '<option value="astro">Static Astro</option>' +
                "</select>" +
              "</span>" +
              '<button type="button" class="btn btn-ghost res-zip-btn" id="lf-zip-scripts" data-kind="scripts">⚙️ Build a zip I\'ll set up myself</button>' +
              '<button type="button" class="btn btn-ghost res-zip-btn res-zip-btn-alt" id="lf-zip-bot" data-kind="bot">🤖 Build a zip for an AI bot</button>' +
            "</span>" +
          "</span>" +
        "</div>" +
        '<p class="res-zip-hint" id="lf-zip-hint">Pick a format and enter your email, then choose how you want to finish it. <strong>Set up myself</strong> gives you a ready-to-run project — install, run a couple commands, done (no AI needed). <strong>For an AI bot</strong> gives you the content plus instructions to hand your AI coding assistant. Either way your exact design and working menus are baked in.</p>' +
        '<p class="res-expiry">Like what you see? We can put it on your own domain and handle any changes you want.</p>' +
        '<button type="button" class="res-again" id="lf-again">↻ Rebuild another site</button>';

      resultEl.scrollIntoView({ behavior: "smooth", block: "start" });
      wireZipButton(previewId, siteName);
      wireAgain();
    }

    // ---- Full site (.zip) — triggered from the result card ------------------
    // Two kinds × two targets. kind='scripts' → ready-to-run project (no AI);
    // kind='bot' → content + AGENT_INSTRUCTIONS for an AI assistant. target ∈
    // {emdash, astro}. Reuses the preview row: /api/replica-offer {choice:'no',
    // target, kind, email} enqueues the worker job; /api/zip-status?id&target&kind is
    // polled (scoped per target+kind so the four outputs never collide).
    function wireZipButton(previewId, siteName) {
      const sel = document.getElementById("lf-zip-target");
      const hint = document.getElementById("lf-zip-hint");
      const btns = [document.getElementById("lf-zip-scripts"), document.getElementById("lf-zip-bot")].filter(Boolean);
      if (!btns.length || !previewId) return;

      function fmtLabel() {
        const v = sel ? sel.value : "emdash";
        return v === "astro" ? "static Astro site" : "EmDash site";
      }
      function kindLabel(kind) {
        return kind === "bot" ? "AI-bot package" : "ready-to-run project";
      }
      function lockButtons(disabled) {
        btns.forEach((b) => { b.disabled = disabled; });
        if (sel) sel.disabled = disabled;
      }

      btns.forEach((btn) => {
        const kind = btn.getAttribute("data-kind") || "scripts";
        const baseLabel = btn.textContent;
        btn.addEventListener("click", async function () {
          const emailInput = document.getElementById("lf-zip-email");
          const optinInput = document.getElementById("lf-zip-optin");
          const optinVal = optinInput ? optinInput.checked : true;
          const zipEmail = emailInput ? emailInput.value.trim() : "";
          if (!zipEmail || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(zipEmail)) {
            if (emailInput) {
              emailInput.classList.add("input-error");
              emailInput.focus();
            }
            if (hint) {
              hint.innerHTML = '<span style="color:#ff6b6b">✕ Please enter a valid email address so we can send you your download link.</span>';
            }
            return;
          }
          if (emailInput) emailInput.classList.remove("input-error");

          const target = sel ? sel.value : "emdash";
          const label = fmtLabel();
          lockButtons(true);
          if (emailInput) emailInput.disabled = true;
          if (optinInput) optinInput.disabled = true;
          btn.classList.add("building");
          btn.innerHTML = '<span class="efw-btn-spin"></span> Building…';
          if (hint) hint.textContent = "Packaging your " + kindLabel(kind) + " — your content, your exact design, and working menus baked into a " + label + ". We'll email your link to " + zipEmail + ". This usually takes a minute or two — keep this page open.";

          // 1) Kick off the build (idempotent on the server, scoped by target+kind).
          try {
            const kick = await fetch(apiBase() + "/api/replica-offer", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id: previewId, choice: "no", target: target, kind: kind, email: zipEmail, optin: optinVal }),
            });
            const kd = await kick.json().catch(() => ({}));
            if (!kick.ok || !kd.ok) {
              if (emailInput) emailInput.disabled = false;
              if (optinInput) optinInput.disabled = false;
              return zipError(btn, hint, baseLabel, (kd && kd.error) || "Couldn't start the build. Please try again.");
            }
          } catch (_) {
            if (emailInput) emailInput.disabled = false;
            if (optinInput) optinInput.disabled = false;
            return zipError(btn, hint, baseLabel, "Network error starting the build. Please try again.");
          }

          // 2) Poll for the finished zip (~up to 5 min), scoped to this target+kind.
          let downloadUrl = null;
          for (let i = 0; i < 50; i++) {
            await new Promise((r) => setTimeout(r, 6000));
            try {
              const s = await fetch(apiBase() + "/api/zip-status?id=" + encodeURIComponent(previewId) + "&target=" + encodeURIComponent(target) + "&kind=" + encodeURIComponent(kind), { cache: "no-store" });
              const sd = await s.json().catch(() => ({}));
              if (sd && sd.ok && sd.ready && sd.download_url) { downloadUrl = sd.download_url; break; }
            } catch (_) {}
          }

          if (!downloadUrl) {
            btn.classList.remove("building");
            btn.innerHTML = "⬇ Still building — check your email";
            lockButtons(false);
            if (emailInput) emailInput.disabled = false;
            if (optinInput) optinInput.disabled = false;
            if (hint) hint.innerHTML = "Your " + esc(label) + " is taking a little longer. We'll <strong>email your download link to " + esc(zipEmail) + "</strong> the moment it's ready (good for 24 hours).";
            return;
          }

          // 3) Done — swap this button for a real download link (fresh element, so a
          //    second tap just re-downloads). The OTHER button re-enables.
          const dl = document.createElement("a");
          dl.className = "btn btn-ghost ready";
          dl.href = downloadUrl;
          dl.setAttribute("download", "");
          dl.textContent = "⬇ Download your " + label + " (.zip)";
          btn.replaceWith(dl);
          if (sel) sel.disabled = false;
          if (emailInput) emailInput.disabled = false;
          if (optinInput) optinInput.disabled = false;
          document.querySelectorAll(".res-zip-btn").forEach((b) => { b.disabled = false; });
          if (hint) hint.innerHTML = kind === "bot"
            ? "✓ Ready! We've also <strong>emailed your link to " + esc(zipEmail) + "</strong> (good for <strong>24 hours</strong>). Unzip it and hand the whole folder to your AI coding assistant — open <code>AGENT_INSTRUCTIONS.md</code> for the prompt."
            : "✓ Ready! We've also <strong>emailed your link to " + esc(zipEmail) + "</strong> (good for <strong>24 hours</strong>). Unzip it, open <code>README.md</code>, and run the couple of commands — no AI needed.";
        });
      });
    }

    function zipError(btn, hint, baseLabel, msg) {
      btn.classList.remove("building");
      btn.innerHTML = baseLabel;
      document.querySelectorAll(".res-zip-btn").forEach((b) => { b.disabled = false; });
      const sel = document.getElementById("lf-zip-target");
      if (sel) sel.disabled = false;
      if (hint) { hint.innerHTML = '<span style="color:#ff6b6b">✕ ' + esc(msg) + "</span>"; }
    }

    function resetTurnstile() { try { if (window.turnstile) window.turnstile.reset(); } catch (_) {} }
    function wireAgain() {
      const again = document.getElementById("lf-again");
      if (again) again.addEventListener("click", () => {
        resultEl.hidden = true;
        form.reset();
        resetTurnstile();
        submitBtn.disabled = false;
        window.scrollTo({ top: form.offsetTop - 120, behavior: "smooth" });
      });
    }
  </script>
</Layout>
