---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Seed escapees (real clients). Each: { name, url, prisoner_no, crime, served, logo, story, rescued_url }
// `story` = the full write-up shown in the detail modal. `rescued_url` optional (the old WP site).
const escapees = [
  {
    name: "Matthew Peiper",
    url: "https://matthewpeiper.com",
    prisoner_no: "0001",
    crime: "Artist portfolio locked in the Etch page-builder — busted out onto a static, plugin-free stack.",
    served: "Time on WordPress (Etch builder)",
    logo: "/images/escapees/matthewpeiper.webp",
    story: "An artist portfolio doing time inside WordPress's Etch page-builder — slow to load, a maintenance headache, and locked to one editor. We broke it out onto a static, plugin-free stack: the same design, now loading in a fraction of the time with nothing to update or patch. Zero plugins, zero database, served straight from the edge.",
  },
  {
    name: "Walnut Grove Assembly of God",
    url: "https://walnutgroveassemblyofgod.church",
    prisoner_no: "0002",
    crime: "A Spirit-filled church in Ivanhoe, CA, doing time on a plugin-heavy WordPress build — broke free onto a fast, secure static site.",
    served: "Years on WordPress",
    logo: "/images/escapees/walnutgrove.webp",
    story: "A Spirit-filled church in Ivanhoe, CA, serving years on a plugin-heavy WordPress build. Every plugin was another lock and another thing that could break. We moved them to a fast, secure static site — no login to get hacked, no plugins to update, and pages that load instantly for their congregation.",
  },
  {
    name: "Brewhemia",
    url: "https://brewhemia.com",
    prisoner_no: "0003",
    crime: "A Cedar Rapids coffee-and-cocktail house serving time on a WordPress/Themify build — broke free onto a fast, static, plugin-free stack.",
    served: "Years on WordPress (Themify)",
    logo: "/images/escapees/brewhemia.webp",
    story: "A Cedar Rapids coffee-and-cocktail house doing time on a WordPress/Themify build. The Themify builder made every edit a wrestling match and dragged the whole site down. We broke them free onto a fast, static, plugin-free stack — the menu, the hours, the vibe, all loading instantly and costing a fraction to run.",
  },
  {
    name: "James Welbes",
    url: "https://jameswelbes.com",
    prisoner_no: "0004",
    crime: "A designer's own portfolio doing time on a WordPress build — broke free onto a fast, static Astro site served from the edge.",
    served: "Years on WordPress",
    logo: "/images/escapees/jameswelbes.webp",
    story: "A designer's own portfolio — the one site that should practice what it preaches — was itself doing time on WordPress. It broke free onto a fast, static Astro site served from the edge. No database, no plugins, no monthly patch cycle. Just clean code and instant loads.",
  },
];

const monogram = (name) =>
  name.replace(/^REPLACE ME —\s*/i, "").split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase() || "??";
---
<Layout
  title="Previous Prisoners — Escape From WP"
  description="Sites that broke out of WordPress. Real migrations, released and running free on a faster, safer stack."
>
  <!-- NAV -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a href={`${base}/`} class="wordmark">
        ESCAPE&nbsp;FROM&nbsp;<span class="wp">WP</span>
      </a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <nav class="nav-links" id="nav-menu">
        <a href={`${base}/#prison`}>The Prison</a>
        <a href={`${base}/#plan`}>The Plan</a>
        <a href={`${base}/liberate`}>Liberate</a>
        <a href={`${base}/evidence`}>Evidence</a>
        <a href={`${base}/escapees`} class="active">Previous Prisoners</a>
        <a href={`${base}/#breakout`} class="btn btn-primary nav-cta">Plan your escape</a>
      </nav>
    </div>
  </header>

  <!-- PAGE HEADER -->
  <section class="wrap page-head">
    <span class="eyebrow danger rise">◦ Release records · declassified</span>
    <h1 class="page-title rise">Previous prisoners.</h1>
    <p class="section-lead rise">
      Every site below did time in WordPress — then broke out. Now they run free on a
      faster, safer, plugin-free stack. These are their release records.
    </p>
  </section>

  <!-- MUGSHOT GRID -->
  <section class="wrap">
    <div class="mug-grid" id="mug-grid">
      {escapees.map((e) => (
        <article
          class="mug rise is-clickable"
          data-escapee
          data-name={e.name}
          data-url={e.url}
          data-rescued={e.rescued_url || ""}
          data-prisoner={e.prisoner_no}
          data-served={e.served}
          data-story={e.story}
          data-image={e.logo ? `${base}${e.logo}` : ""}
          tabindex="0"
          role="button"
          aria-label={`View release record for ${e.name}`}
        >
          <div class="mug-photo">
            {e.logo
              ? <img src={`${base}${e.logo}`} alt={`${e.name} website hero`} loading="lazy" />
              : <span class="mug-mono">{monogram(e.name)}</span>}
            <span class="mug-height">6'0"—5'0"—4'0"</span>
            <span class="mug-stamp">RELEASED</span>
          </div>
          <div class="mug-info">
            <span class="mug-no">PRISONER&nbsp;#{e.prisoner_no}</span>
            <h2 class="mug-name">{e.name}</h2>
            <p class="mug-crime">“{e.crime}”</p>
            <div class="mug-meta">
              <span class="mug-served">◦ Served: {e.served}</span>
              <span class="mug-link">View record ↗</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- SUBMIT YOUR OWN -->
  <section class="wrap submit-section rise" id="report">
    <span class="eyebrow danger">◦ Report a breakout</span>
    <h2 class="section-title">Did you break a site out of WordPress?</h2>
    <p class="section-lead">
      Rescued a site from WordPress — yours or a client's? Add it to the release records.
      Submissions are reviewed before they go public.
    </p>

    <form class="submit-form" id="escapee-form" novalidate>
      <div class="field">
        <label for="f-business">Business name <span class="req">*</span></label>
        <input type="text" id="f-business" name="business_name" required maxlength="120" placeholder="The name on the door" />
      </div>

      <div class="field">
        <label for="f-website">Business website <span class="req">*</span></label>
        <input type="url" id="f-website" name="website_url" required placeholder="https://theirsite.com" />
        <span class="hint">The new site, running now.</span>
      </div>

      <div class="field">
        <label for="f-rescued">Website you rescued <span class="req">*</span></label>
        <input type="url" id="f-rescued" name="rescued_url" required placeholder="https://oldsite.com" />
        <span class="hint">The site that was on WordPress before the breakout.</span>
      </div>

      <div class="field">
        <label for="f-thumb">Thumbnail <span class="opt">(optional)</span></label>
        <input type="file" id="f-thumb" name="thumbnail" accept="image/png,image/jpeg,image/webp,image/gif" />
        <span class="hint">If you don't upload a thumbnail, we'll just try to use the site's OG image.</span>
      </div>

      <div class="field">
        <label for="f-story">The story <span class="opt">(optional)</span></label>
        <textarea id="f-story" name="story" maxlength="4000" placeholder="How did you get this site off WordPress? What was it doing time for, and how's it running now?"></textarea>
        <span class="hint">Tell the story of the breakout — shown on the site's release record.</span>
      </div>

      <div class="field">
        <label for="f-casestudy">Case study link <span class="opt">(optional)</span></label>
        <input type="url" id="f-casestudy" name="case_study_url" placeholder="https://yoursite.com/case-study" />
        <span class="hint">A write-up or case study page, if you have one.</span>
      </div>

      <!-- honeypot -->
      <input type="text" name="website_hp" tabindex="-1" autocomplete="off" class="hp-field" aria-hidden="true" />

      <div class="form-foot">
        <button type="submit" class="btn btn-primary" id="submit-btn">▸ Submit for review</button>
        <span class="form-status" id="form-status" role="status" aria-live="polite"></span>
      </div>
    </form>
  </section>

  <!-- CTA -->
  <section class="wrap breakout-cta rise">
    <h2 class="section-title">Your site could be next out the gate.</h2>
    <a href={`${base}/#breakout`} class="btn btn-primary">▸ Plan your escape</a>
  </section>

  <!-- DETAIL MODAL -->
  <div class="modal-overlay" id="escapee-modal" aria-hidden="true">
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modal-name">
      <button class="modal-close" id="modal-close" aria-label="Close">✕</button>
      <div class="modal-grid">
        <div class="modal-photo" id="modal-photo"></div>
        <div class="modal-body">
          <span class="mug-no" id="modal-no">PRISONER&nbsp;#0000</span>
          <h2 class="modal-name" id="modal-name">—</h2>
          <span class="modal-served" id="modal-served"></span>
          <div class="modal-story" id="modal-story"></div>
          <div class="modal-links" id="modal-links"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <span class="wordmark small">ESCAPE&nbsp;FROM&nbsp;<span class="wp">WP</span></span>
      <span class="footer-mono">◦ WordPress migration &amp; rescue · escapefromwp.com</span>
      <span class="footer-mono dim">© {new Date().getFullYear()} — All units accounted for.</span>
    </div>
  </footer>

  <style>
    /* NAV (shared with home page) */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(11, 4, 5, 0.72);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--steel);
    }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 62px; }
    .wordmark {
      font-family: var(--font-mono); font-weight: 700; font-size: 15px;
      letter-spacing: 0.06em; color: var(--chalk);
    }
    .wordmark .wp { color: var(--signal-red); }
    .wordmark.small { font-size: 13px; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a:not(.btn) {
      font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--slate); transition: color .15s;
    }
    .nav-links a:not(.btn):hover { color: var(--term-green); }
    .nav-cta { padding: 9px 16px; }

    /* HAMBURGER (hidden on desktop) */
    .nav-toggle {
      display: none; background: none; border: 1px solid var(--steel);
      width: 40px; height: 36px; cursor: pointer; padding: 0;
      flex-direction: column; align-items: center; justify-content: center; gap: 5px;
    }
    .nav-toggle-bar { display: block; width: 20px; height: 2px; background: var(--chalk); transition: transform .2s, opacity .2s; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* FOOTER (shared with home page) */
    .footer { border-top: 1px solid var(--steel); padding: 40px 0; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
    .footer-mono { font-family: var(--font-mono); font-size: 12px; color: var(--slate); letter-spacing: 0.04em; }
    .footer-mono.dim { color: var(--slate-dim); }

    .page-head { padding-top: 140px; padding-bottom: 24px; }
    .page-title { font-size: clamp(38px, 7vw, 72px); margin-bottom: 20px; line-height: 1.02; }

    .mug-grid {
      display: grid; gap: 20px;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      padding-bottom: 40px;
    }
    .mug {
      border: 1px solid var(--steel); background: rgba(255,255,255,0.015);
      display: flex; flex-direction: column;
    }
    .mug.is-clickable { cursor: pointer; transition: border-color .15s, transform .15s; }
    .mug.is-clickable:hover { border-color: var(--term-green); transform: translateY(-2px); }
    .mug.is-clickable:focus-visible { outline: 2px solid var(--term-green); outline-offset: 2px; }
    .mug-photo {
      position: relative; aspect-ratio: 16 / 10; overflow: hidden;
      background:
        repeating-linear-gradient(90deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 46px),
        linear-gradient(160deg, #14090b, #0b0405);
      display: flex; align-items: center; justify-content: center;
      border-bottom: 1px solid var(--steel);
    }
    .mug-photo img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); }
    .mug-mono {
      font-family: var(--font-mono); font-size: 52px; font-weight: 700;
      color: var(--chalk); letter-spacing: 0.04em; opacity: 0.9;
    }
    .mug-height {
      position: absolute; left: 0; right: 0; bottom: 0;
      font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.35em;
      color: var(--slate); text-align: center; padding: 4px 0;
      background: rgba(0,0,0,0.45); border-top: 1px solid var(--steel);
    }
    .mug-stamp {
      position: absolute; top: 14px; right: -34px; transform: rotate(14deg);
      font-family: var(--font-mono); font-weight: 700; font-size: 13px; letter-spacing: 0.2em;
      color: var(--term-green); border: 2px solid var(--term-green);
      padding: 4px 40px; opacity: 0.9;
    }
    .mug-info { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .mug-no { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--signal-red); }
    .mug-name { font-size: 21px; line-height: 1.15; }
    .mug-crime { color: var(--slate); font-size: 15px; font-style: italic; flex: 1; }
    .mug-meta { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 6px; flex-wrap: wrap; }
    .mug-served { font-family: var(--font-mono); font-size: 11px; color: var(--term-green); }
    .mug-link { font-family: var(--font-mono); font-size: 12px; color: var(--chalk); border-bottom: 1px solid var(--steel); }
    .mug.is-clickable:hover .mug-link { color: var(--term-green); border-color: var(--term-green); }

    .breakout-cta { text-align: center; padding: 40px 0 90px; display: flex; flex-direction: column; align-items: center; gap: 22px; }
    .nav-links .active { color: var(--term-green); }

    /* SUBMIT FORM */
    .submit-section {
      border: 1px solid var(--steel); padding: 40px clamp(20px, 4vw, 44px);
      margin: 20px 0 60px; background: rgba(255,255,255,0.012);
      scroll-margin-top: 80px;
    }
    .submit-section .eyebrow { display: inline-block; margin-bottom: 14px; }
    .submit-section .section-title { font-size: clamp(24px, 4vw, 34px); margin-bottom: 12px; }
    .submit-section .section-lead { margin-bottom: 30px; max-width: 60ch; }
    .submit-form { display: flex; flex-direction: column; gap: 22px; max-width: 640px; }
    .field { display: flex; flex-direction: column; gap: 7px; }
    .field label {
      font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--chalk);
    }
    .field .req { color: var(--signal-red); }
    .field .opt { color: var(--slate-dim); font-weight: 400; text-transform: none; letter-spacing: 0; }
    .field input, .field textarea {
      background: rgba(0,0,0,0.35); border: 1px solid var(--steel); color: var(--chalk);
      font-family: inherit; font-size: 15px; padding: 12px 14px; border-radius: 0;
      transition: border-color .15s;
    }
    .field input:focus, .field textarea:focus { outline: none; border-color: var(--term-green); }
    .field textarea { resize: vertical; min-height: 120px; }
    .field input[type="file"] { padding: 10px; font-family: var(--font-mono); font-size: 13px; color: var(--slate); cursor: pointer; }
    .field input[type="file"]::file-selector-button {
      background: var(--steel); color: var(--chalk); border: none; padding: 8px 14px;
      font-family: var(--font-mono); font-size: 12px; margin-right: 12px; cursor: pointer;
    }
    .field .hint { font-size: 13px; color: var(--slate-dim); line-height: 1.4; }
    .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
    .form-foot { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
    .form-status { font-family: var(--font-mono); font-size: 13px; }
    .form-status.ok { color: var(--term-green); }
    .form-status.err { color: var(--signal-red); }
    .btn[disabled] { opacity: 0.5; cursor: not-allowed; }

    /* MODAL */
    .modal-overlay {
      position: fixed; inset: 0; z-index: 200; display: none;
      align-items: center; justify-content: center; padding: 24px;
      background: rgba(0,0,0,0.78); backdrop-filter: blur(4px);
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      position: relative; width: 70vw; max-width: 900px; max-height: 86vh; overflow-y: auto;
      background: #0b0405; border: 1px solid var(--term-green);
      box-shadow: 0 0 0 1px rgba(78,227,107,0.15);
    }
    .modal-close {
      position: absolute; top: 12px; right: 12px; z-index: 2;
      background: rgba(0,0,0,0.6); border: 1px solid var(--steel); color: var(--chalk);
      width: 38px; height: 38px; cursor: pointer; font-size: 16px; line-height: 1;
      font-family: var(--font-mono); transition: border-color .15s, color .15s;
    }
    .modal-close:hover { border-color: var(--signal-red); color: var(--signal-red); }
    .modal-grid { display: grid; grid-template-columns: 1fr; }
    .modal-photo {
      aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--steel);
      background:
        repeating-linear-gradient(90deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 46px),
        linear-gradient(160deg, #14090b, #0b0405);
      display: flex; align-items: center; justify-content: center;
    }
    .modal-photo img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); }
    .modal-photo .mug-mono { font-size: 64px; }
    .modal-body { padding: 26px clamp(22px, 4vw, 40px) 34px; display: flex; flex-direction: column; gap: 12px; }
    .modal-name { font-size: clamp(26px, 4vw, 40px); line-height: 1.05; }
    .modal-served { font-family: var(--font-mono); font-size: 12px; color: var(--term-green); letter-spacing: 0.04em; }
    .modal-story { color: var(--slate); font-size: 16px; line-height: 1.7; margin-top: 6px; white-space: pre-wrap; }
    .modal-links { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 14px; }
    .modal-links a {
      font-family: var(--font-mono); font-size: 13px; color: var(--chalk);
      border: 1px solid var(--steel); padding: 10px 16px; transition: border-color .15s, color .15s;
    }
    .modal-links a:hover { border-color: var(--term-green); color: var(--term-green); }
    .modal-links a.rescued:hover { border-color: var(--signal-red); color: var(--signal-red); }

    /* RESPONSIVE (match home page) */
    @media (max-width: 900px) {
      .nav-toggle { display: flex; }
      .nav-links {
        position: absolute; top: 62px; left: 0; right: 0;
        flex-direction: column; align-items: stretch; gap: 0;
        background: rgba(11, 4, 5, 0.97); backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--steel);
        max-height: 0; overflow: hidden; transition: max-height .25s ease;
      }
      .nav-links.open { max-height: 400px; }
      .nav-links a:not(.btn) { padding: 16px 20px; border-top: 1px solid var(--steel); }
      .nav-links .nav-cta { margin: 14px 20px 18px; text-align: center; }
    }
    @media (max-width: 640px) {
      .modal-box { width: 92vw; max-height: 90vh; }
    }
  </style>

  <script is:inline define:vars={{ base }}>
    // --- nav toggle ---
    const navToggle = document.querySelector(".nav-toggle");
    const navMenu = document.getElementById("nav-menu");
    if (navToggle && navMenu) {
      navToggle.addEventListener("click", () => {
        const open = navMenu.classList.toggle("open");
        navToggle.setAttribute("aria-expanded", open ? "true" : "false");
      });
      navMenu.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          navMenu.classList.remove("open");
          navToggle.setAttribute("aria-expanded", "false");
        })
      );
    }

    const esc = (s) => (s == null ? "" : String(s)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"));
    const monogram = (name) =>
      (name || "").split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase() || "??";

    // --- MODAL ---
    const overlay = document.getElementById("escapee-modal");
    const mPhoto = document.getElementById("modal-photo");
    const mNo = document.getElementById("modal-no");
    const mName = document.getElementById("modal-name");
    const mServed = document.getElementById("modal-served");
    const mStory = document.getElementById("modal-story");
    const mLinks = document.getElementById("modal-links");
    let lastFocused = null;

    function openModal(d) {
      lastFocused = document.activeElement;
      mNo.innerHTML = "PRISONER&nbsp;#" + esc(d.prisoner || "0000");
      mName.textContent = d.name || "";
      mServed.textContent = d.served ? "◦ Served: " + d.served : "";
      mStory.textContent = d.story || "No story on file for this breakout — but the site's running free.";
      mPhoto.innerHTML = d.image
        ? `<img src="${esc(d.image)}" alt="${esc(d.name)} website">`
        : `<span class="mug-mono">${esc(monogram(d.name))}</span>`;
      let links = `<a href="${esc(d.url)}" target="_blank" rel="noopener">Visit free site ↗</a>`;
      if (d.rescued) links += `<a class="rescued" href="${esc(d.rescued)}" target="_blank" rel="noopener">The old WordPress site ↗</a>`;
      if (d.caseStudy) links += `<a href="${esc(d.caseStudy)}" target="_blank" rel="noopener">Read the case study ↗</a>`;
      mLinks.innerHTML = links;
      overlay.classList.add("open");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      document.getElementById("modal-close").focus();
    }
    function closeModal() {
      overlay.classList.remove("open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocused) lastFocused.focus();
    }
    document.getElementById("modal-close").addEventListener("click", closeModal);
    overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && overlay.classList.contains("open")) closeModal(); });

    function wireCard(el) {
      const open = () => openModal({
        name: el.dataset.name, url: el.dataset.url, rescued: el.dataset.rescued,
        prisoner: el.dataset.prisoner, served: el.dataset.served,
        story: el.dataset.story, image: el.dataset.image, caseStudy: el.dataset.casestudy,
      });
      el.addEventListener("click", open);
      el.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(); } });
    }
    document.querySelectorAll("[data-escapee]").forEach(wireCard);

    // --- LOAD APPROVED SUBMISSIONS and append ---
    (async () => {
      try {
        const res = await fetch(`${base}/api/escapees`);
        if (!res.ok) return;
        const data = await res.json();
        if (!data.ok || !data.escapees || !data.escapees.length) return;
        const grid = document.getElementById("mug-grid");
        for (const e of data.escapees) {
          const art = document.createElement("article");
          art.className = "mug is-clickable";
          art.tabIndex = 0; art.setAttribute("role", "button");
          art.dataset.name = e.name; art.dataset.url = e.url;
          art.dataset.rescued = e.rescued_url || ""; art.dataset.prisoner = e.prisoner_no;
          art.dataset.served = "Time on WordPress"; art.dataset.story = e.story || "";
          art.dataset.casestudy = e.case_study_url || "";
          art.dataset.image = e.image ? (e.image.startsWith("http") ? e.image : base + e.image) : "";
          const img = art.dataset.image;
          const crime = (e.story || "").slice(0, 120) + ((e.story || "").length > 120 ? "…" : "");
          art.innerHTML = `
            <div class="mug-photo">
              ${img ? `<img src="${esc(img)}" alt="${esc(e.name)} website" loading="lazy">` : `<span class="mug-mono">${esc(monogram(e.name))}</span>`}
              <span class="mug-height">6'0"—5'0"—4'0"</span>
              <span class="mug-stamp">RELEASED</span>
            </div>
            <div class="mug-info">
              <span class="mug-no">PRISONER&nbsp;#${esc(e.prisoner_no)}</span>
              <h2 class="mug-name">${esc(e.name)}</h2>
              <p class="mug-crime">${crime ? "“" + esc(crime) + "”" : "Broke free from WordPress."}</p>
              <div class="mug-meta">
                <span class="mug-served">◦ Served: Time on WordPress</span>
                <span class="mug-link">View record ↗</span>
              </div>
            </div>`;
          grid.appendChild(art);
          wireCard(art);
        }
      } catch (_) { /* ignore — seed escapees already shown */ }
    })();

    // --- SUBMIT FORM ---
    const form = document.getElementById("escapee-form");
    const statusEl = document.getElementById("form-status");
    const submitBtn = document.getElementById("submit-btn");
    const isStaging = location.hostname.endsWith("github.io");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      statusEl.className = "form-status";
      statusEl.textContent = "";

      if (isStaging) {
        statusEl.className = "form-status err";
        statusEl.textContent = "Preview mode — submissions only work on the live site.";
        return;
      }

      const biz = form.business_name.value.trim();
      const site = form.website_url.value.trim();
      const rescued = form.rescued_url.value.trim();
      if (!biz || !site || !rescued) {
        statusEl.className = "form-status err";
        statusEl.textContent = "All three fields are required.";
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting…";
      try {
        const fd = new FormData(form);
        const res = await fetch(`${base}/api/submit-escapee`, { method: "POST", body: fd });
        const data = await res.json();
        if (data.ok) {
          form.reset();
          statusEl.className = "form-status ok";
          statusEl.textContent = "Got it — your breakout is in the queue for review. Thanks!";
        } else {
          statusEl.className = "form-status err";
          statusEl.textContent = data.error || "Something went wrong. Try again.";
        }
      } catch (_) {
        statusEl.className = "form-status err";
        statusEl.textContent = "Network error — please try again.";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "▸ Submit for review";
      }
    });
  </script>
</Layout>
