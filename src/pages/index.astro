---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const prison = [
  { code: "01", t: "Updates that break things", d: "WordPress sends update notifications almost every week. Ignore them and your site becomes a target. Run them and things break. There's no winning." },
  { code: "02", t: "You're now the IT department", d: "Nobody told you that buying WordPress hosting meant you'd also handle security patches, plugin conflicts, and server errors. But here you are." },
  { code: "03", t: "One bad plugin from hacked", d: "43% of hacked websites run WordPress — not because the owners were careless, but because every plugin is another unlocked door. The more plugins, the more doors." },
  { code: "04", t: "Hosting fees that never stop climbing", d: "You started at $10/month. Now it's $30, maybe $40. And you're still doing all your own maintenance. That's not hosting — that's renting a house and doing your own plumbing." },
];

const steps = [
  { n: "01", t: "You tell us your URL", d: "That's the hardest step. Paste your website address and tell us what's been driving you crazy — we'll handle the rest." },
  { n: "02", t: "We rebuild your site", d: "We copy your site exactly — same look, same pages, same content. You won't notice a visual difference. Your visitors definitely won't." },
  { n: "03", t: "We move it to your domain", d: "We put it on fast, reliable servers and switch your domain over on a schedule you approve. No downtime. Your visitors never see a thing." },
  { n: "04", t: "We keep it running", d: "No updates to run. No security scares. No plugins to patch. You just run your business. We handle anything that comes up." },
];

const outside = [
  { stat: "90+", label: "PageSpeed score", d: "Your site loads in under a second. Google rewards fast sites with better search rankings — and visitors don't leave before your page finishes loading." },
  { stat: "$0", label: "Monthly maintenance", d: "No plugins to patch. No updates to run. Nothing to break at 2am. The architecture is fundamentally different — there's simply nothing to maintain." },
  { stat: "99.99%", label: "Uptime", d: "Your site is served from a global network — not one server that can crash. No traffic spike can knock it offline." },
];
---
<Layout>
  <!-- NAV -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a href="#top" class="wordmark">
        ESCAPE&nbsp;FROM&nbsp;<span class="wp">WP</span>
      </a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <nav class="nav-links" id="nav-menu">
        <a href="#prison">Why leave</a>
        <a href="#plan">How it works</a>
        <a href="#tiers">Pricing</a>
        <a href={`${base}/liberate`}>Free preview</a>
        <a href={`${base}/evidence`}>Evidence</a>
        <a href={`${base}/stories`}>Stories</a>
        <a href={`${base}/escapees`}>Who we've helped</a>
        <a href="#breakout" class="btn btn-primary nav-cta">Get started</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="hero-img" style={`background-image:url('${base}/images/hero-1600.webp')`}></div>
    <div class="hero-scan"></div>
    <div class="wrap hero-content">
      <span class="eyebrow danger rise">◦ For small business owners who built their own site</span>
      <h1 class="hero-title rise">
        Your website<br />shouldn't be this<br />much work.
      </h1>
      <p class="hero-sub rise">
        You built a WordPress site to help your business — not to spend weekends
        dealing with updates, security warnings, and things that randomly break.
        We move your site off WordPress completely. Same look. Same content.
        No more maintenance headaches.
      </p>
      <div class="hero-cta rise">
        <a href="#breakout" class="btn btn-primary">▸ Get started — free assessment</a>
        <a href="#prison" class="btn btn-ghost">See why people leave</a>
      </div>
    </div>
  </section>

  <!-- THE PRISON -->
  <section id="prison" class="wrap">
    <span class="section-num rise">// 01 — Why people leave</span>
    <h2 class="section-title rise">WordPress was built for developers. Your business isn't.</h2>
    <p class="section-lead rise">
      You didn't sign up to be a webmaster. But WordPress comes with a full-time
      maintenance job baked in. Here's what people are dealing with.
    </p>
    <div class="grid-4">
      {prison.map((p) => (
        <div class="cell rise">
          <span class="cell-code">{p.code}</span>
          <h3 class="cell-title">{p.t}</h3>
          <p class="cell-desc">{p.d}</p>
        </div>
      ))}
    </div>
    <p class="prison-evidence-link rise">
      Want to see proof? <a href={`${base}/evidence`}>We've collected real articles, security reports, and posts from across the web →</a>
    </p>
  </section>

  <hr class="hair" />

  <!-- THE PLAN -->
  <section id="plan" class="wrap">
    <span class="section-num rise">// 02 — How it works</span>
    <h2 class="section-title rise">We handle everything. You do nothing.</h2>
    <p class="section-lead rise">
      There's no complicated process on your end. You give us your site URL,
      we do the work, and you get a faster, worry-free website on the other side.
    </p>
    <div class="steps">
      {steps.map((s) => (
        <div class="step rise">
          <span class="step-n">{s.n}</span>
          <div class="step-body">
            <h3 class="step-title">{s.t}</h3>
            <p class="cell-desc">{s.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="hair" />

  <!-- THE OUTSIDE -->
  <section id="outside" class="wrap">
    <span class="section-num rise">// 03 — What changes</span>
    <h2 class="section-title rise">A website that runs itself.</h2>
    <p class="section-lead rise">
      Same look. Same content. Just without the maintenance, the security worries,
      and the hosting bills that keep going up.
    </p>
    <div class="grid-3">
      {outside.map((o) => (
        <div class="stat-cell rise">
          <span class="stat-num">{o.stat}</span>
          <span class="stat-label">{o.label}</span>
          <p class="cell-desc">{o.d}</p>
        </div>
      ))}
    </div>
  </section>

  <hr class="hair" />

  <!-- THE OPTIONS / TIERS -->
  <section id="tiers" class="wrap">
    <span class="section-num rise">// 04 — Pricing</span>
    <h2 class="section-title rise">Simple, flat pricing.</h2>
    <p class="section-lead rise">
      Start free. See your site rebuilt before you spend a dollar.
    </p>
    <div class="tiers-grid">
      <div class="tier-card rise">
        <span class="tier-tag">Free</span>
        <h3 class="tier-title">See it first</h3>
        <p class="tier-price">$0</p>
        <p class="tier-desc">Paste your WordPress URL and we'll show you exactly what your site looks like off WordPress — before you commit to anything. Takes about 2 minutes.</p>
        <a href={`${base}/liberate`} class="btn btn-ghost tier-cta">▸ Try the free preview</a>
      </div>
      <div class="tier-card tier-featured rise">
        <span class="tier-tag tag-green">Most popular</span>
        <h3 class="tier-title">We do everything</h3>
        <p class="tier-price">$49<span class="tier-mo">/month</span></p>
        <p class="tier-desc">We migrate your site, set it up on your domain, and keep it running. No WordPress. No plugins. No maintenance. Just a fast website that works. Cancel anytime.</p>
        <a href="#breakout" class="btn btn-primary tier-cta">▸ Get started</a>
      </div>
      <div class="tier-card rise">
        <span class="tier-tag">Custom</span>
        <h3 class="tier-title">Bigger sites</h3>
        <p class="tier-price">Quote</p>
        <p class="tier-desc">Online stores, membership sites, large blogs, or anything complex. Get in touch and we'll talk through what you've got and what makes sense.</p>
        <a href="#breakout" class="btn btn-ghost tier-cta">▸ Get a quote</a>
      </div>
    </div>
  </section>

  <hr class="hair" />
  <section id="breakout" class="breakout">
    <div class="wrap breakout-inner">
      <div class="breakout-left rise">
        <span class="eyebrow">◦ Free assessment</span>
        <h2 class="section-title">Let's see what you've got.</h2>
        <p class="section-lead">
          Tell us your website URL and what's been driving you crazy.
          We'll come back with a plain-English answer and a flat monthly price.
          No tech jargon, no sales pressure.
        </p>
        <ul class="breakout-list">
          <li>◦ Free assessment — no commitment required</li>
          <li>◦ Your domain name and Google rankings stay intact</li>
          <li>◦ Flat $49/month after migration</li>
        </ul>
      </div>
      <form class="breakout-form rise" id="escape-form">
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="site">Your WordPress site URL</label>
          <input id="site" name="site" type="text" placeholder="yoursite.com" />
        </div>
        <div class="field">
          <label for="message">What's been the biggest headache?</label>
          <textarea id="message" name="message" rows="4" placeholder="Slow? Got hacked? Just tired of the updates and maintenance?"></textarea>
        </div>
        <div class="field" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;overflow:hidden">
          <label for="website_hp">Website</label>
          <input id="website_hp" name="website_hp" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary form-submit">▸ Request extraction</button>
        <p class="form-status" id="form-status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <span class="wordmark small">ESCAPE&nbsp;FROM&nbsp;<span class="wp">WP</span></span>
      <span class="footer-mono">◦ WordPress migration &amp; rescue · escapefromwp.com</span>
      <span class="footer-mono dim">© {new Date().getFullYear()} — Your site deserves better.</span>
      <a class="footer-mono dim footer-privacy" href="/privacy/">Privacy</a>
    </div>
  </footer>

  <script is:inline>
    // Mobile nav toggle
    const navToggle = document.querySelector(".nav-toggle");
    const navMenu = document.getElementById("nav-menu");
    if (navToggle && navMenu) {
      navToggle.addEventListener("click", () => {
        const open = navMenu.classList.toggle("open");
        navToggle.setAttribute("aria-expanded", open ? "true" : "false");
      });
      navMenu.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          navMenu.classList.remove("open");
          navToggle.setAttribute("aria-expanded", "false");
        })
      );
    }

    const form = document.getElementById("escape-form");
    const status = document.getElementById("form-status");
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        // Staging preview (GitHub Pages) has no backend — short-circuit with a friendly note.
        if (location.hostname.endsWith("github.io")) {
          status.textContent = "◦ Preview mode — the extraction request form is live on escapefromwp.com.";
          status.className = "form-status ok";
          return;
        }
        status.textContent = "◦ Transmitting extraction request…";
        status.className = "form-status pending";
        const data = Object.fromEntries(new FormData(form));
        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          if (res.ok) {
            form.reset();
            status.textContent = "◦ Received. I'll be in touch within one business day. Stay low.";
            status.className = "form-status ok";
          } else {
            const j = await res.json().catch(() => ({}));
            throw new Error(j.error || "Transmission failed");
          }
        } catch (err) {
          status.textContent = "◦ " + (err.message || "Transmission failed") + ". Please try again in a moment.";
          status.className = "form-status err";
        }
      });
    }
  </script>

  <style>
    /* NAV */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(11, 4, 5, 0.72);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--steel);
    }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 62px; }
    .wordmark {
      font-family: var(--font-mono); font-weight: 700; font-size: 15px;
      letter-spacing: 0.06em; color: var(--chalk);
    }
    .wordmark .wp { color: var(--signal-red); }
    .wordmark.small { font-size: 13px; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a:not(.btn) {
      font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--slate); transition: color .15s;
    }
    .nav-links a:not(.btn):hover { color: var(--term-green); }
    .nav-cta { padding: 9px 16px; }

    /* HAMBURGER (hidden on desktop) */
    .nav-toggle {
      display: none; background: none; border: 1px solid var(--steel);
      width: 40px; height: 36px; cursor: pointer; padding: 0;
      flex-direction: column; align-items: center; justify-content: center; gap: 5px;
    }
    .nav-toggle-bar { display: block; width: 20px; height: 2px; background: var(--chalk); transition: transform .2s, opacity .2s; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* HERO */
    .hero { min-height: 100vh; display: flex; align-items: center; padding: 0; overflow: hidden; }
    .hero-img {
      position: absolute; inset: 0; background-size: cover; background-position: center 30%;
      z-index: 0;
    }
    .hero-img::after {
      content: ""; position: absolute; inset: 0;
      background:
        linear-gradient(90deg, rgba(11,4,5,0.95) 0%, rgba(11,4,5,0.72) 42%, rgba(11,4,5,0.25) 100%),
        linear-gradient(0deg, rgba(11,4,5,0.95) 0%, rgba(11,4,5,0) 45%);
    }
    .hero-scan {
      position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: .5;
      background: repeating-linear-gradient(to bottom, transparent 0 3px, rgba(78,227,107,0.03) 3px 4px);
    }
    .hero-content { position: relative; z-index: 2; padding-top: 90px; padding-bottom: 60px; }
    .hero-title {
      font-size: clamp(38px, 7.5vw, 88px); line-height: 0.98; margin: 22px 0 26px;
      max-width: 16ch; letter-spacing: -0.04em;
    }
    .hero-title .wp-out {
      color: var(--signal-red); position: relative; white-space: nowrap;
    }
    .hero-title .wp-out::after {
      content: ""; position: absolute; left: -2%; right: -2%; top: 52%; height: 5px;
      background: var(--signal-red); transform: rotate(-2.5deg);
      box-shadow: 0 0 14px rgba(227,39,53,.6);
    }
    .hero-sub { color: var(--slate); font-size: clamp(15px, 1.6vw, 19px); max-width: 56ch; line-height: 1.65; }
    .hero-cta { display: flex; gap: 14px; margin: 34px 0 40px; flex-wrap: wrap; }
    .hero-readout {
      display: flex; gap: 26px; flex-wrap: wrap;
      font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em;
      color: var(--slate-dim); text-transform: uppercase;
      border-top: 1px solid var(--steel); padding-top: 18px; max-width: 620px;
    }
    .hero-readout .ok { color: var(--term-green); }

    /* GRIDS / CELLS */
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: 48px;
      background: var(--steel); border: 1px solid var(--steel); }
    .cell { background: var(--carbon); padding: 30px 26px 34px; }
    .cell-code { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--signal-red); }
    .prison-evidence-link {
      margin-top: 28px; margin-bottom: 40px; font-size: 15px; color: var(--slate);
    }
    .prison-evidence-link a {
      color: var(--term-green); border-bottom: 1px solid rgba(78,227,107,0.35);
      transition: border-color .15s;
    }
    .prison-evidence-link a:hover { border-color: var(--term-green); }
    .cell-title { font-size: 19px; margin: 16px 0 10px; }
    .cell-desc { color: var(--slate); font-size: 14.5px; line-height: 1.62; }

    /* STEPS */
    .steps { margin-top: 48px; border-top: 1px solid var(--steel); }
    .step { display: grid; grid-template-columns: 120px 1fr; gap: 30px; align-items: start;
      padding: 34px 0; border-bottom: 1px solid var(--steel); }
    .step-n { font-family: var(--font-mono); font-size: 40px; font-weight: 700;
      color: var(--graphite); -webkit-text-stroke: 1px var(--steel-lit); }
    .step-title { font-size: 22px; margin-bottom: 8px; }
    .step:hover .step-n { color: var(--term-green-dim); -webkit-text-stroke: 1px var(--term-green); }

    /* STATS */
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 48px;
      background: var(--steel); border: 1px solid var(--steel); }
    .stat-cell { background: var(--carbon); padding: 36px 30px 40px; }
    .stat-num { font-family: var(--font-mono); font-size: 52px; font-weight: 700; color: var(--term-green);
      display: block; line-height: 1; letter-spacing: -0.02em; text-shadow: 0 0 24px rgba(78,227,107,.28); }
    .stat-label { display: block; font-size: 15px; font-weight: 600; margin: 14px 0 12px; letter-spacing: -0.01em; }

    /* TIERS */
    .tiers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }
    .tier-card {
      border: 1px solid var(--steel); background: rgba(255,255,255,0.015);
      padding: 30px 26px 34px; display: flex; flex-direction: column; gap: 12px;
      transition: border-color .15s;
    }
    .tier-card:hover { border-color: var(--steel-lit); }
    .tier-featured { border-color: var(--term-green); background: rgba(78,227,107,0.04); }
    .tier-featured:hover { border-color: var(--term-green); }
    .tier-tag {
      font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--slate); align-self: flex-start;
      border: 1px solid var(--steel); padding: 3px 8px;
    }
    .tag-green { color: var(--term-green); border-color: var(--term-green); }
    .tier-title { font-size: 22px; line-height: 1.1; }
    .tier-price {
      font-family: var(--font-mono); font-size: 38px; font-weight: 700;
      color: var(--chalk); line-height: 1; letter-spacing: -0.02em;
    }
    .tier-mo { font-size: 16px; font-weight: 400; color: var(--slate); }
    .tier-desc { color: var(--slate); font-size: 14.5px; line-height: 1.62; flex: 1; }
    .tier-cta { margin-top: 8px; text-align: center; justify-content: center; }

    /* BREAKOUT / CONTACT */
    .breakout { background:
      radial-gradient(120% 100% at 100% 0%, rgba(227,39,53,0.06), transparent 55%),
      var(--graphite); border-top: 1px solid var(--steel); }
    .breakout-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
    .breakout-list { list-style: none; margin-top: 28px; display: grid; gap: 12px;
      font-family: var(--font-mono); font-size: 13px; color: var(--term-green); letter-spacing: 0.02em; }
    .breakout-form { background: var(--carbon); border: 1px solid var(--steel); border-radius: var(--radius);
      padding: 32px; display: grid; gap: 18px; }
    .field { display: grid; gap: 7px; }
    .field label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--slate); }
    .field input, .field textarea {
      background: var(--graphite-2); border: 1px solid var(--steel); border-radius: var(--radius);
      color: var(--chalk); font-family: var(--font-display); font-size: 15px; padding: 12px 14px;
      transition: border-color .15s; resize: vertical;
    }
    .field input:focus, .field textarea:focus { outline: none; border-color: var(--term-green); }
    .field input::placeholder, .field textarea::placeholder { color: var(--slate-dim); }
    .form-submit { width: 100%; justify-content: center; margin-top: 4px; }
    .form-status { font-family: var(--font-mono); font-size: 12px; min-height: 16px; letter-spacing: 0.02em; }
    .form-status.ok { color: var(--term-green); }
    .form-status.err { color: var(--signal-red-lit); }
    .form-status.pending { color: var(--slate); }

    /* FOOTER */
    .footer { border-top: 1px solid var(--steel); padding: 40px 0; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
    .footer-mono { font-family: var(--font-mono); font-size: 12px; color: var(--slate); letter-spacing: 0.04em; }
    .footer-mono.dim { color: var(--slate-dim); }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      .grid-4 { grid-template-columns: repeat(2, 1fr); }
      .tiers-grid { grid-template-columns: 1fr; }
      .breakout-inner { grid-template-columns: 1fr; gap: 40px; }
      .nav-toggle { display: flex; }
      .nav-links {
        position: absolute; top: 62px; left: 0; right: 0;
        flex-direction: column; align-items: stretch; gap: 0;
        background: rgba(11, 4, 5, 0.97); backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--steel);
        max-height: 0; overflow: hidden; transition: max-height .25s ease;
      }
      .nav-links.open { max-height: 400px; }
      .nav-links a:not(.btn) { padding: 16px 20px; border-top: 1px solid var(--steel); }
      .nav-links .nav-cta { margin: 14px 20px 18px; text-align: center; }
    }
    @media (max-width: 640px) {
      :root { --gap-section: 84px; }
      .grid-4, .grid-3 { grid-template-columns: 1fr; }
      .step { grid-template-columns: 60px 1fr; gap: 18px; }
      .step-n { font-size: 30px; }
      .hero-readout { gap: 16px; }
    }
  </style>
</Layout>
